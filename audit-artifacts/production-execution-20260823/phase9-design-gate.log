73:.session-actions { display: inline-flex; align-items: center; gap: .45rem; }.header-account, .header-signout { display: inline-flex; align-items: center; justify-content: center; gap: .4rem; min-height: 2.45rem; padding: .5rem .65rem; border: 1px solid var(--line); border-radius: .75rem; background: var(--surface); color: var(--ink); font: inherit; font-size: .8rem; font-weight: 800; }.header-account:hover, .header-account:focus-visible, .header-signout:hover, .header-signout:focus-visible { border-color: var(--brand); outline: none; background: var(--brand-soft); }.header-signout:disabled { opacity: .6; cursor: wait; }
80:.locale-option { border-radius: 999px; border-color: transparent; background: rgba(245,247,250,.86); transition: transform 160ms var(--ease-out), background 160ms var(--ease-out), color 160ms var(--ease-out); }.locale-option:hover { transform: translateY(-1px); background: var(--surface); box-shadow: 0 4px 12px rgba(20,26,42,.08); }.locale-option:focus-visible { outline: 3px solid rgba(35,181,206,.28); outline-offset: 2px; }.locale-option-active { background: var(--brand-soft); border-color: rgba(35,181,206,.28); }
81:.button { gap: .5rem; min-height: 3rem; border-radius: 1rem; box-shadow: 0 1px 0 rgba(255,255,255,.52) inset; transition: transform 160ms var(--ease-out), box-shadow 160ms var(--ease-out), background 160ms var(--ease-out); }.button:hover { transform: translateY(-2px); }.button:active { transform: scale(.97); }.button:focus-visible { outline: 3px solid rgba(35,181,206,.35); outline-offset: 3px; }.button-primary { background: linear-gradient(135deg, #26c4d8, #1598b3); box-shadow: 0 10px 24px rgba(26,159,182,.24), inset 0 1px 1px rgba(255,255,255,.3); }.button-primary:hover { background: linear-gradient(135deg, #25bdd1, #118da7); }.button-secondary { border-color: rgba(229,232,238,.92); background: rgba(255,255,255,.78); box-shadow: var(--premium-soft-shadow); }
