85:@media (prefers-reduced-motion: no-preference) { .topbar, .trust-card, .premium-trust-card, .quickTile, .featureCard, .moreLink, .medicine-card, .appointment-card, .notification-card, .reminder-card, .order-card, .button, .header-account, .header-signout { transition-timing-function: var(--ease-out); }.premium-hero-copy { animation: premium-enter 420ms var(--ease-out) both; }.premium-trust-card { animation: premium-enter 520ms 60ms var(--ease-out) both; } } @keyframes premium-enter { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
