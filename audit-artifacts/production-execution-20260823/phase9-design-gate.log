== design static checks ==
1::root { color-scheme: light; --ink: #102334; --muted: #526473; --line: #d9e4ea; --surface: #ffffff; --canvas: #f5fafb; --brand: #0b98ae; --brand-deep: #087486; --mint: #dff7f2; --danger: #b4232c; } * { box-sizing: border-box; } html, body { min-height: 100%; } body { margin: 0; background: var(--canvas); color: var(--ink); font-family: Arial, Tahoma, sans-serif; } a { color: inherit; text-decoration: none; } button, input { font: inherit; } button { cursor: pointer; }.shell { min-width: 0; min-height: 100vh; display: flex; flex-direction: column; }.topbar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem max(1.25rem, calc((100vw - 1180px) / 2)); background: rgba(255,255,255,.92); border-bottom: 1px solid var(--line); backdrop-filter: blur(12px); }.topbar > *, .hero > *, .auth-card { min-width: 0; }.brand { display: inline-flex; align-items: center; gap: .65rem; font-weight: 800; }.brand-mark { display: grid; place-items: center; width: 2.15rem; height: 2.15rem; border-radius: .72rem; background: var(--brand); color: white; font-weight: 900; }.nav-actions { display: flex; gap: .65rem; align-items: center; }.locale-selector { display: flex; flex-wrap: wrap; justify-content: end; gap: .3rem; max-width: 30rem; }.locale-option { display: inline-flex; align-items: center; min-height: 2.15rem; padding: .35rem .55rem; border: 1px solid var(--line); border-radius: .55rem; background: var(--surface); color: var(--muted); font-size: .82rem; font-weight: 700; white-space: nowrap; }.locale-option:hover, .locale-option:focus-visible { border-color: var(--brand); color: var(--brand-deep); outline: none; }.locale-option-active { border-color: var(--brand); background: var(--mint); color: var(--brand-deep); }.button { display: inline-flex; align-items: center; justify-content: center; min-height: 2.7rem; padding: .65rem 1rem; border: 1px solid transparent; border-radius: .75rem; font-weight: 700; }.button-primary { background: var(--brand); color: white; }.button-primary:hover { background: var(--brand-deep); }.button-secondary { background: var(--surface); border-color: var(--line); color: var(--ink); }.main { width: min(1180px, calc(100% - 2.5rem)); margin: 0 auto; }.hero { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(18rem, .85fr); gap: 2rem; padding: clamp(3rem, 8vw, 7rem) 0; align-items: center; }.eyebrow { color: var(--brand-deep); font-size: .82rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }.hero h1 { margin: .65rem 0 1rem; font-size: clamp(2.2rem, 5vw, 4.4rem); line-height: 1.08; letter-spacing: -.045em; overflow-wrap: anywhere; }.hero p { margin: 0; max-width: 40rem; color: var(--muted); font-size: 1.1rem; line-height: 1.8; overflow-wrap: anywhere; }.hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.75rem; }.trust-card { border: 1px solid var(--line); border-radius: 1.35rem; padding: 1.35rem; background: linear-gradient(145deg, #fff, var(--mint)); box-shadow: 0 18px 50px rgba(22,71,84,.09); }.trust-card h2 { margin: 0 0 .7rem; font-size: 1.15rem; }.trust-card p { font-size: .95rem; }.trust-list { display: grid; gap: .75rem; margin: 1.25rem 0 0; padding: 0; list-style: none; }.trust-list li { display: flex; gap: .65rem; align-items: start; color: #234052; }.trust-list span { color: var(--brand-deep); font-weight: 900; }.auth-wrap { display: grid; width: 100%; min-width: 0; place-items: center; padding: clamp(2rem, 8vw, 5rem) 0; }.auth-card { inline-size: 100%; min-inline-size: 0; max-inline-size: 29rem; background: var(--surface); border: 1px solid var(--line); border-radius: 1.25rem; padding: 1.5rem; box-shadow: 0 20px 45px rgba(22,71,84,.08); }.auth-card h1 { margin: 0; font-size: 1.7rem; }.auth-card p { color: var(--muted); line-height: 1.6; }.field { display: grid; gap: .45rem; margin-top: 1rem; font-weight: 700; }.field input { min-width: 0; min-height: 3rem; border: 1px solid var(--line); border-radius: .7rem; padding: .7rem .8rem; background: white; }.field input:focus { outline: 3px solid rgba(11,152,174,.18); border-color: var(--brand); }.form-error { margin-top: .9rem; color: var(--danger); font-weight: 700; }.form-note { margin-top: 1rem; color: var(--muted); font-size: .86rem; line-height: 1.55; }.dashboard { padding: 2rem 0; }.dashboard h1 { margin: 0; }.status-card { margin-top: 1.25rem; border: 1px solid var(--line); border-radius: 1rem; background: var(--surface); padding: 1.25rem; }.status-card p { color: var(--muted); line-height: 1.7; }.skeleton { display: grid; gap: .8rem; padding: 2rem; }.skeleton i { display: block; height: 1rem; border-radius: .5rem; background: linear-gradient(90deg,#edf3f5,#f9fcfd,#edf3f5); background-size: 200% 100%; animation: shimmer 1.4s infinite; } @keyframes shimmer { to { background-position: -200% 0; } } @media (max-width: 720px) { .topbar { align-items: flex-start; flex-wrap: wrap; padding-inline: 1rem; }.main { width: min(1180px, calc(100% - 2rem)); }.hero { grid-template-columns: minmax(0, 1fr); padding-block: 3rem; }.hero h1 { font-size: clamp(2.1rem, 12vw, 3.4rem); }.brand { flex-basis: 100%; }.nav-actions { display: grid; grid-template-columns: minmax(0, 1fr) auto; width: 100%; gap: .55rem; align-items: center; }.locale-selector { min-width: 0; max-width: none; flex-wrap: nowrap; justify-content: start; overflow-x: auto; padding-bottom: .3rem; scroll-snap-type: x proximity; }.locale-option { flex: 0 0 auto; padding: .32rem .45rem; font-size: .78rem; scroll-snap-align: start; }.nav-actions > .button { min-height: 2.45rem; padding: .55rem .7rem; white-space: nowrap; } }
