{
  "$schema": "https://json.schemastore.org/style-dictionary.json",
  "meta": {
    "name": "Nabd Plus — Ultra-Premium Unified Design System V3",
    "version": "3.0.0",
    "source": "Fair Mint Vision V3 — unified across 271 screens",
    "rule": "Single source of truth. All platforms (web/app/provider/admin) MUST read these tokens. Admin Theme Control writes here.",
    "changes": "Navy #17243D → Forest Ink #1E332E (warmer, less suffocating). Deep Sage removed. Fair Mint #5FD9B3 is now MAIN."
  },
  "color": {
    "main": {
      "fair-mint": "#5FD9B3",
      "fair-mint-deep": "#3DBB9A",
      "fair-mint-soft": "#E7FFF6",
      "fair-mint-50": "#F0FDF9"
    },
    "sub": {
      "lime": "#B8E030",
      "lime-deep": "#9BC019",
      "lime-soft": "#F0F7C8",
      "peach": "#FF8A65",
      "peach-soft": "#FFF3E0"
    },
    "ink": {
      "forest": "#1E332E",
      "forest-soft": "#2A4A3E",
      "slate": "#64748B",
      "slate-light": "#94A3B8"
    },
    "light": {
      "bg": "#FDFDFC",
      "bg-warm": "#F5F3EF",
      "surface": "#FFFFFF",
      "surface-glass": "rgba(255,255,255,0.72)",
      "line": "#E8EDEE",
      "line-soft": "#F0F4F3",
      "success": "#10B981",
      "success-surface": "#ECFDF5",
      "warning": "#F59E0B",
      "warning-surface": "#FFFBEB",
      "danger": "#EF4444",
      "danger-surface": "#FEF2F2",
      "info": "#06B6D4",
      "info-surface": "#ECFEFF"
    },
    "dark": {
      "bg": "#0F1F1C",
      "surface": "#1A2E28",
      "ink": "#F0FDF9",
      "ink-2": "#9CB8AD",
      "line": "#2A3F38"
    }
  },
  "radius": { "sm": 10, "md": 16, "lg": 22, "xl": 28, "full": 9999 },
  "font": {
    "ui": "Inter, ui-sans-serif, -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "arabic": "'IBM Plex Sans Arabic', 'Noto Sans Arabic', 'Tajawal', Tahoma, Arial, sans-serif",
    "display": "'Instrument Serif', Georgia, serif"
  },
  "shadow": {
    "sm": "0 1px 3px rgba(30,51,46,.06), 0 4px 12px rgba(30,51,46,.04)",
    "md": "0 8px 32px rgba(30,51,46,.08), 0 2px 8px rgba(30,51,46,.04)",
    "lg": "0 20px 60px rgba(30,51,46,.12), 0 4px 16px rgba(30,51,46,.06)",
    "glass": "0 8px 32px rgba(30,51,46,.08), 0 1px 0 rgba(255,255,255,.8) inset"
  },
  "motion": { "fast": 150, "base": 250, "slow": 400, "ease": "cubic-bezier(.22,1,.36,1)", "ease-spring": "cubic-bezier(.34,1.56,.64,1)" },
  "a11y": { "min-touch-pt": 44, "min-contrast-text": 4.5 }
}
