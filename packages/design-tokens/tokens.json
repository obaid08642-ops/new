{
  "$schema": "https://json.schemastore.org/style-dictionary.json",
  "meta": {
    "name": "Nabd Plus canonical design tokens",
    "version": "1.0.0",
    "source": "patient-app/src/theme/brand.ts + patient-web/app/globals.css (2026-09-12)",
    "rule": "This file is the single source of truth. Platform mirrors (patient-app brand.ts, web globals.css, provider-app theme/tokens.ts) MUST match these values."
  },
  "color": {
    "primary": { "lime": "#B8E030", "lime-soft": "#D9F26B", "lime-deep": "#7CB518" },
    "secondary": { "mint": "#5FD9B3", "mint-deep": "#00876F", "yellow": "#FFC93C", "coral": "#FF4D5A", "navy": "#16213A", "sky": "#4FA8E0" },
    "light": {
      "bg": "#F2F4F7", "surface": "#FFFFFF", "brand-bg": "#F5F5F7",
      "ink": "#141A2A", "ink-2": "#4C5566", "ink-3": "#8C93A3", "line": "#E5E8EE",
      "success": "#5BA84F", "success-surface": "#EBF6E9",
      "warning": "#F0A526", "warning-surface": "#FEF4E0",
      "danger": "#F0695C", "danger-surface": "#FEEFED",
      "info": "#4889D4", "info-surface": "#E8F1FB"
    },
    "dark": {
      "bg": "#0E1422", "surface": "#1A2234",
      "ink": "#F2F4F7", "ink-2": "#B8BEC9", "ink-3": "#7C8494", "line": "#2A3346",
      "success-surface": "#1F2E1E", "warning-surface": "#30261A", "danger-surface": "#351F1E", "info-surface": "#1E2835"
    }
  },
  "radius": { "sm": 8, "md": 14, "lg": 22, "xl": 28, "full": 9999 },
  "font": {
    "ui": "ui-sans-serif, -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Segoe UI Variable', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
    "ui-arabic": "'Noto Sans Arabic', 'Segoe UI', Tahoma, Arial, sans-serif"
  },
  "shadow": {
    "sm": "0 1px 2px rgba(16,24,40,.04), 0 2px 7px rgba(16,24,40,.04)",
    "md": "0 10px 28px rgba(16,24,40,.07), 0 2px 6px rgba(16,24,40,.03)",
    "lg": "0 22px 54px rgba(16,24,40,.10), 0 4px 12px rgba(16,24,40,.04)"
  },
  "motion": { "fast": 150, "base": 250, "slow": 400, "easing": "cubic-bezier(.22,1,.36,1)" },
  "a11y": { "min-touch-pt": 44, "min-contrast-text": 4.5 }
}
