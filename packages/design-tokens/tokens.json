      "sunken": { "light": "#E8E8ED", "dark": "#0E1F31" },
      "media": { "light": "#F2F3F5", "dark": "#1A3148" },
      "inverse": { "light": "#0B1B2B", "dark": "#12263A" }
    },

    "border": {
      "subtle": { "light": "#E5E5EA", "dark": "rgba(255,255,255,0.10)" },
      "strong": { "light": "#D8D8DE", "dark": "rgba(255,255,255,0.20)" },
      "hairline": { "light": "rgba(11,27,43,0.04)", "dark": "rgba(255,255,255,0.08)" },
      "onGlass": { "light": "rgba(11,27,43,0.08)", "dark": "rgba(255,255,255,0.12)" }
    },

    "text": {
      "primary": { "light": "#0B1B2B", "dark": "#F5F5F7" },
      "secondary": { "light": "#6E6E73", "dark": "#9AA4B2" },
      "tertiary": { "light": "#5B6470", "dark": "#8B99A8" },
      "onBrand": { "light": "#FFFFFF", "dark": "#0B1B2B" },
      "onInverse": "#F5F5F7",
      "onInverseSecondary": "#9AA4B2",
      "link": { "light": "#C8202F", "dark": "#D7FF00" },
      "price": { "light": "#C8202F", "dark": "#FF8A91" },
      "onAccent": "#0B1B2B"
    },

    "icon": {
      "primary": { "light": "#0B1B2B", "dark": "#F5F5F7" },
      "secondary": { "light": "#6E6E73", "dark": "#9AA4B2" },
      "onBrand": { "light": "#FFFFFF", "dark": "#0B1B2B" },
      "favorite": "#D42A38",
      "onSolid": "#FFFFFF",
      "ratingStar": { "light": "#A65A00", "dark": "#FFD166" },
      "ratingStarOnBrand": { "light": "#FFD166", "dark": "#0B1B2B" }
    },

    "action": {
      "primary": { "bg": { "light": "#D42A38", "dark": "#FF6B73" }, "fg": { "light": "#FFFFFF", "dark": "#0B1B2B" }, "gradient": { "_note": "Handoff §1: primary buttons are a coral gradient (180deg) with a white label, from the boards (CheckoutV2, Settings, Cart...). Dark keeps the flat dark primary: no dark board shows a gradient button. The board top colour #E8384A is darkened to #E62337, the smallest step that gives the white label 4.5:1 (owner rule of 2026-10-04 for contrast).", "from": { "light": "#E62337", "dark": "#FF6B73" }, "to": { "light": "#D42A38", "dark": "#FF6B73" } } },
      "fab": { "_note": "The raised centre (Consultations) button of the tab bar, canvas/HomeApp.dc.html: 180deg gradient, white glyph, ringed in the canvas colour. Same in both themes on the board.", "from": "#FF5A63", "to": "#D42A38", "fg": "#FFFFFF" },
      "secondary": { "bg": { "light": "#FFFFFF", "dark": "#1A3148" }, "fg": { "light": "#0B1B2B", "dark": "#F5F5F7" } },
      "selected": { "bg": { "light": "#0B1B2B", "dark": "#F5F5F7" }, "fg": { "light": "#F5F5F7", "dark": "#0B1B2B" } },
      "accent": { "bg": "#D7FF00", "fg": "#0B1B2B" },
      "danger": { "bg": { "light": "#D42A38", "dark": "#FF6B73" }, "fg": { "light": "#FFFFFF", "dark": "#0B1B2B" } }
    },

    "accent": {
      "_note": "Acid lime. The canvas is explicit: DARK SURFACES ONLY. White on lime is 1.15:1 and lime on a light canvas is unreadable, so every use is a fill with ink text, a track, or a glow. The muted value is the same lime at 14-16% for a chip or a progress track.",
      "lime": "#D7FF00",
      "limeMuted": "rgba(215,255,0,0.16)"
    },

    "status": {
      "success": { "fg": { "light": "#1F7A5C", "dark": "#6FE0B8" }, "bg": { "light": "#DDF4EC", "dark": "rgba(111,224,184,0.14)" }, "fill": { "light": "#3FBF9A", "dark": "#6FE0B8" } },
      "warning": { "fg": { "light": "#8A5A00", "dark": "#FFD166" }, "bg": { "light": "#FFF4D6", "dark": "rgba(255,209,102,0.14)" } },
      "danger": { "fg": { "light": "#B81E2B", "dark": "#FF8A91" }, "bg": { "light": "#FFE3E5", "dark": "rgba(255,107,115,0.14)" } },
      "info": { "fg": { "light": "#3A56D4", "dark": "#9DB0FF" }, "bg": { "light": "#E3E9FF", "dark": "rgba(110,139,255,0.16)" }, "fill": { "light": "#3A56D4", "dark": "#6E8BFF" } },
      "neutral": { "fg": { "light": "#6E6E73", "dark": "#9AA4B2" }, "bg": { "light": "#F5F5F7", "dark": "#12263A" } }
    },

    "service": {
      "_note": "Handoff §1 (docs/design/DESIGN_HANDOFF_FINAL.md). The 10 tones are copied exactly from docs/design/canvas/FIcon.dc.html (T[tone] = [fg, bg, fgDark, bgDark, solidFrom, solidTo]); fg/bg are {light,dark} so fgDark/bgDark are the dark values. solid.from/to is the 160deg gradient of the 'solid' chip (white glyph). The per-service keys below repeat the tone the service map assigns: pharmacy=coral, consult=blue, lab=mint, radiology=violet, nursing=teal, mind=violet, nutrition=lime, family=peach, maternity=pink, map=amber, health=coral, emergency=peach, insurance=blue, points=amber. Keep them equal to their tone. Owner decision 2026-10-04: in light mode the glyph colour of 5 tones is darkened by the smallest step that reaches the repo's 4.5:1 bar (coral #D42A38→#CE2936, mint #0F8A68→#0E7C5E, amber #B86400→#A65A00, peach #C2501E→#B74B1C, teal #0B7F95→#0A778C). Backgrounds and dark values are exactly as on the board. Solid chips (white glyph, color.icon.onSolid) must reach 3:1 at both gradient ends; design-session correction 2026-10-04: coral.from #FF6B73→#FF5C65, mint.from #2DBF92→#27A67F, amber.from #FFB547→#D68000, amber.to #E08A00→#D38200, pink.from #F573A6→#F4609A, lime.from #8CC63F→#71A230, peach.from #FF8A5C→#FF6021, teal.from #23B5CE→#1FA2B8 (blue, violet and ink already pass).",
      "coral": { "fg": { "light": "#CE2936", "dark": "#FF8A91" }, "bg": { "light": "#FFE8EA", "dark": "rgba(255,107,115,0.16)" }, "solid": { "from": "#FF5C65", "to": "#E8384A" } },
      "blue": { "fg": { "light": "#2D4FD6", "dark": "#9DB0FF" }, "bg": { "light": "#E7ECFF", "dark": "rgba(110,139,255,0.16)" }, "solid": { "from": "#5B7CFF", "to": "#3A56D4" } },
      "mint": { "fg": { "light": "#0E7C5E", "dark": "#6FE0BC" }, "bg": { "light": "#E1F6EE", "dark": "rgba(79,210,168,0.15)" }, "solid": { "from": "#27A67F", "to": "#16956F" } },
      "violet": { "fg": { "light": "#6A3FD1", "dark": "#C2AEFF" }, "bg": { "light": "#EFEAFF", "dark": "rgba(156,125,255,0.16)" }, "solid": { "from": "#9C7DFF", "to": "#7A52E0" } },
      "amber": { "fg": { "light": "#A65A00", "dark": "#FFC56E" }, "bg": { "light": "#FFF1DB", "dark": "rgba(255,181,71,0.15)" }, "solid": { "from": "#D68000", "to": "#D38200" } },
      "pink": { "fg": { "light": "#C2296E", "dark": "#FF9CC6" }, "bg": { "light": "#FFE7F1", "dark": "rgba(255,128,180,0.15)" }, "solid": { "from": "#F4609A", "to": "#D63B80" } },
      "lime": { "fg": { "light": "#4A7A00", "dark": "#C2EA6B" }, "bg": { "light": "#EDF8D6", "dark": "rgba(168,217,74,0.15)" }, "solid": { "from": "#71A230", "to": "#5E9A00" } },
      "peach": { "fg": { "light": "#B74B1C", "dark": "#FFAE8A" }, "bg": { "light": "#FFEDE3", "dark": "rgba(255,156,114,0.15)" }, "solid": { "from": "#FF6021", "to": "#E0632C" } },
      "teal": { "fg": { "light": "#0A778C", "dark": "#6FD6E8" }, "bg": { "light": "#E0F5F8", "dark": "rgba(35,181,206,0.15)" }, "solid": { "from": "#1FA2B8", "to": "#0E97AE" } },
      "ink": { "fg": { "light": "#0B1B2B", "dark": "#F5F5F7" }, "bg": { "light": "#EDEFF2", "dark": "rgba(255,255,255,0.10)" }, "solid": { "from": "#0B1B2B", "to": "#1A3148" } },
      "pharmacy": { "bg": { "light": "#FFE8EA", "dark": "rgba(255,107,115,0.16)" }, "glyph": { "light": "#CE2936", "dark": "#FF8A91" } },
      "consult": { "bg": { "light": "#E7ECFF", "dark": "rgba(110,139,255,0.16)" }, "glyph": { "light": "#2D4FD6", "dark": "#9DB0FF" } },
      "lab": { "bg": { "light": "#E1F6EE", "dark": "rgba(79,210,168,0.15)" }, "glyph": { "light": "#0E7C5E", "dark": "#6FE0BC" } },
      "radiology": { "bg": { "light": "#EFEAFF", "dark": "rgba(156,125,255,0.16)" }, "glyph": { "light": "#6A3FD1", "dark": "#C2AEFF" } },
      "nursing": { "bg": { "light": "#E0F5F8", "dark": "rgba(35,181,206,0.15)" }, "glyph": { "light": "#0A778C", "dark": "#6FD6E8" } },
      "mind": { "bg": { "light": "#EFEAFF", "dark": "rgba(156,125,255,0.16)" }, "glyph": { "light": "#6A3FD1", "dark": "#C2AEFF" } },
      "nutrition": { "bg": { "light": "#EDF8D6", "dark": "rgba(168,217,74,0.15)" }, "glyph": { "light": "#4A7A00", "dark": "#C2EA6B" } },
      "family": { "bg": { "light": "#FFEDE3", "dark": "rgba(255,156,114,0.15)" }, "glyph": { "light": "#B74B1C", "dark": "#FFAE8A" } },
      "maternity": { "bg": { "light": "#FFE7F1", "dark": "rgba(255,128,180,0.15)" }, "glyph": { "light": "#C2296E", "dark": "#FF9CC6" } },
      "map": { "bg": { "light": "#FFF1DB", "dark": "rgba(255,181,71,0.15)" }, "glyph": { "light": "#A65A00", "dark": "#FFC56E" } },
      "health": { "bg": { "light": "#FFE8EA", "dark": "rgba(255,107,115,0.16)" }, "glyph": { "light": "#CE2936", "dark": "#FF8A91" } },
      "emergency": { "bg": { "light": "#FFEDE3", "dark": "rgba(255,156,114,0.15)" }, "glyph": { "light": "#B74B1C", "dark": "#FFAE8A" } },
      "insurance": { "bg": { "light": "#E7ECFF", "dark": "rgba(110,139,255,0.16)" }, "glyph": { "light": "#2D4FD6", "dark": "#9DB0FF" } },
      "points": { "bg": { "light": "#FFF1DB", "dark": "rgba(255,181,71,0.15)" }, "glyph": { "light": "#A65A00", "dark": "#FFC56E" } }
    },

