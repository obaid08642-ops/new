{
  "$schema": "https://json.schemastore.org/style-dictionary.json",
  "meta": {
    "name": "Nabd+ Design System",
    "version": "4.0.0",
    "source": "Owner-approved canvas — docs/design/canvas/ (System, Palette, IconSet, Home, HomeDark, WebHome, Product, Checkout, Booking, Doctor, Success) and docs/audit/05_OWNER_ADDITIONS_DESIGN_AND_GAPS.md Part A",
    "rule": "Single source of truth. patient-web, patient-app, provider-app and admin MUST read these tokens. Screens may not hardcode a colour, size, radius, spacing, shadow, icon or animation.",
    "supersedes": "The Fair Mint / Forest Ink V3 palette that lived in this file before 2026-09-29 is retired and must not be used anywhere.",
    "valueForm": "A string means the value is identical in both themes. {\"light\":…,\"dark\":…} means it differs; the dark value is the one that applies to the dark canvas."
  },

  "color": {
    "brand": {
      "coral": { "light": "#FF4B55", "dark": "#FF6B73" },
      "ink": "#0B1B2B",
      "canvas": "#F5F5F7"
    },

    "bg": {
      "canvas": { "light": "#F5F5F7", "dark": "#0B1B2B" },
      "surface": { "light": "#FFFFFF", "dark": "#12263A" },
      "elevated": { "light": "#FFFFFF", "dark": "#1A3148" },
      "sunken": { "light": "#E8E8ED", "dark": "#0E1F31" },
      "inverse": { "light": "#0B1B2B", "dark": "#12263A" }
    },

    "border": {
      "subtle": { "light": "#E5E5EA", "dark": "rgba(255,255,255,0.10)" },
      "strong": { "light": "#D8D8DE", "dark": "rgba(255,255,255,0.20)" },
      "hairline": { "light": "rgba(11,27,43,0.04)", "dark": "rgba(255,255,255,0.08)" },
      "onGlass": { "light": "rgba(11,27,43,0.08)", "dark": "rgba(255,255,255,0.12)" }
    },

    "text": {
      "primary": { "light": "#0B1B2B", "dark": "#F5F5F7" },
      "secondary": { "light": "#6E6E73", "dark": "#9AA4B2" },
      "tertiary": { "light": "#5B6470", "dark": "#8B99A8" },
      "onBrand": { "light": "#FFFFFF", "dark": "#0B1B2B" },
      "onInverse": "#F5F5F7",
      "onInverseSecondary": "#9AA4B2",
      "link": { "light": "#C8202F", "dark": "#D7FF00" },
      "onAccent": "#0B1B2B"
    },

    "icon": {
      "primary": { "light": "#0B1B2B", "dark": "#F5F5F7" },
      "secondary": { "light": "#6E6E73", "dark": "#9AA4B2" },
      "onBrand": { "light": "#FFFFFF", "dark": "#0B1B2B" },
      "favorite": "#D42A38"
    },

    "action": {
      "primary": { "bg": { "light": "#D42A38", "dark": "#FF6B73" }, "fg": { "light": "#FFFFFF", "dark": "#0B1B2B" } },
      "secondary": { "bg": { "light": "#FFFFFF", "dark": "#1A3148" }, "fg": { "light": "#0B1B2B", "dark": "#F5F5F7" } },
      "selected": { "bg": { "light": "#0B1B2B", "dark": "#F5F5F7" }, "fg": { "light": "#F5F5F7", "dark": "#0B1B2B" } },
      "accent": { "bg": "#D7FF00", "fg": "#0B1B2B" },
      "danger": { "bg": { "light": "#D42A38", "dark": "#FF6B73" }, "fg": { "light": "#FFFFFF", "dark": "#0B1B2B" } }
    },

    "accent": {
      "_note": "Acid lime. The canvas is explicit: DARK SURFACES ONLY. White on lime is 1.15:1 and lime on a light canvas is unreadable, so every use is a fill with ink text, a track, or a glow. The muted value is the same lime at 14-16% for a chip or a progress track.",
      "lime": "#D7FF00",
      "limeMuted": "rgba(215,255,0,0.16)"
    },

    "status": {
      "success": { "fg": { "light": "#1F7A5C", "dark": "#6FE0B8" }, "bg": { "light": "#DDF4EC", "dark": "rgba(111,224,184,0.14)" }, "fill": { "light": "#3FBF9A", "dark": "#6FE0B8" } },
      "warning": { "fg": { "light": "#8A5A00", "dark": "#FFD166" }, "bg": { "light": "#FFF4D6", "dark": "rgba(255,209,102,0.14)" } },
      "danger": { "fg": { "light": "#B81E2B", "dark": "#FF8A91" }, "bg": { "light": "#FFE3E5", "dark": "rgba(255,107,115,0.14)" } },
      "info": { "fg": { "light": "#3A56D4", "dark": "#9DB0FF" }, "bg": { "light": "#E3E9FF", "dark": "rgba(110,139,255,0.16)" }, "fill": { "light": "#3A56D4", "dark": "#6E8BFF" } },
      "neutral": { "fg": { "light": "#6E6E73", "dark": "#9AA4B2" }, "bg": { "light": "#F5F5F7", "dark": "#12263A" } }
    },

    "service": {
      "pharmacy": { "bg": { "light": "#FFE3E5", "dark": "rgba(255,107,115,0.14)" }, "glyph": { "light": "#B81E2B", "dark": "#FF8A91" } },
      "consult": { "bg": { "light": "#E3E9FF", "dark": "rgba(110,139,255,0.16)" }, "glyph": { "light": "#3A56D4", "dark": "#9DB0FF" } },
      "lab": { "bg": { "light": "#DDF4EC", "dark": "rgba(111,224,184,0.14)" }, "glyph": { "light": "#1F7A5C", "dark": "#6FE0B8" } },
      "radiology": { "bg": { "light": "#F0E8FF", "dark": "rgba(195,168,255,0.16)" }, "glyph": { "light": "#5A31A8", "dark": "#C3A8FF" } },
      "nursing": { "bg": { "light": "#FFF1CC", "dark": "rgba(255,209,102,0.14)" }, "glyph": { "light": "#8A5A00", "dark": "#FFD166" } },
      "mind": { "bg": { "light": "#FCE7F3", "dark": "rgba(244,184,228,0.16)" }, "glyph": { "light": "#9B2C6B", "dark": "#F4B8E4" } },
      "nutrition": { "bg": { "light": "#EDF7DC", "dark": "rgba(142,220,94,0.16)" }, "glyph": { "light": "#3F6B12", "dark": "#8EDC5E" } },
      "family": { "bg": { "light": "#FFE9DE", "dark": "rgba(255,179,138,0.16)" }, "glyph": { "light": "#A6501E", "dark": "#FFB38A" } }
    },

    "glass": {
      "bg": { "light": "rgba(255,255,255,0.78)", "dark": "rgba(18,38,58,0.72)" },
      "bgStrong": { "light": "rgba(255,255,255,0.90)", "dark": "rgba(18,38,58,0.90)" },
      "scrim": { "light": "rgba(11,27,43,0.06)", "dark": "rgba(255,255,255,0.08)" },
      "blur": "20px"
    },

    "track": {
      "filled": "#D7FF00",
      "rest": { "light": "rgba(11,27,43,0.18)", "dark": "rgba(255,255,255,0.14)" }
    },

    "iconArt": {
      "_note": "The illustrated icon set (12.A6) is flat artwork, identical in both themes exactly as the canvas shows it. Readability comes from the 2.2px ink outline, not from the fill, so these are not text/background pairs and carry no contrast pair. A new illustrated icon is drawn with this palette and nothing else.",
      "ink": "#0B1B2B",
      "paper": "#FFFFFF",
      "coral": "#FF6B73",
      "amber": "#FFD166",
      "blue": "#6E8BFF",
      "blueSoft": "#9DB0FF",
      "mint": "#3FBF9A",
      "mintSoft": "#6FE0B8",
      "violet": "#C3A8FF",
      "lavender": "#D2B8FF",
      "pink": "#F4B8E4",
      "lime": "#8EDC5E",
      "skin": "#FFB38A"
    }
  },

  "space": {
    "3xs": "4px", "2xs": "8px", "xs": "12px", "sm": "16px", "md": "20px",
    "lg": "24px", "xl": "32px", "2xl": "40px", "3xl": "48px", "4xl": "56px", "5xl": "64px"
  },

  "radius": {
    "sm": "8px", "md": "12px", "lg": "16px", "xl": "20px", "2xl": "24px",
    "3xl": "28px", "4xl": "32px", "5xl": "36px", "pill": "9999px"
  },

  "font": {
    "family": {
      "sans": "'Readex Pro', 'Noto Sans Arabic', 'Noto Sans Devanagari', 'Noto Sans Bengali', 'Noto Nastaliq Urdu', system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
      "brand": "'Readex Pro', 'Noto Sans Arabic', system-ui, sans-serif",
      "locale": {
        "ar": "'Readex Pro', 'Noto Sans Arabic', system-ui, sans-serif",
        "en": "'Readex Pro', system-ui, sans-serif",
        "ur": "'Noto Nastaliq Urdu', 'Readex Pro', system-ui, sans-serif",
        "hi": "'Noto Sans Devanagari', 'Readex Pro', system-ui, sans-serif",
        "fil": "'Readex Pro', system-ui, sans-serif",
        "bn": "'Noto Sans Bengali', 'Readex Pro', system-ui, sans-serif"
      }
    },
    "size": {
      "display": { "size": "40px", "lineHeight": "1.2", "weight": 700 },
      "h1": { "size": "26px", "lineHeight": "1.3", "weight": 700 },
      "h2": { "size": "24px", "lineHeight": "1.3", "weight": 700 },
      "h3": { "size": "20px", "lineHeight": "1.4", "weight": 700 },
      "h4": { "size": "17px", "lineHeight": "1.4", "weight": 700 },
      "bodyLg": { "size": "17px", "lineHeight": "1.5", "weight": 500 },
      "body": { "size": "15px", "lineHeight": "1.7", "weight": 400 },
      "bodyStrong": { "size": "15px", "lineHeight": "1.7", "weight": 700 },
      "caption": { "size": "13px", "lineHeight": "1.6", "weight": 400 },
      "label": { "size": "12.5px", "lineHeight": "1.4", "weight": 500 },
      "micro": { "size": "11.5px", "lineHeight": "1.3", "weight": 500 }
    },
    "weights": { "regular": 400, "medium": 500, "semiBold": 700 },
    "load": {
      "ar": { "families": ["Readex+Pro", "Noto+Sans+Arabic"], "weights": [300, 400, 500, 700] },
      "en": { "families": ["Readex+Pro"], "weights": [300, 400, 500, 700] },
      "fil": { "families": ["Readex+Pro"], "weights": [300, 400, 500, 700] },
      "ur": { "families": ["Readex+Pro", "Noto+Nastaliq+Urdu"], "weights": [300, 400, 500, 700] },
      "hi": { "families": ["Readex+Pro", "Noto+Sans+Devanagari"], "weights": [300, 400, 500, 700] },
      "bn": { "families": ["Readex+Pro", "Noto+Sans+Bengali"], "weights": [300, 400, 500, 700] }
    }
  },

  "shadow": {
    "tile": { "light": "0 8px 24px rgba(11,27,43,0.07)", "dark": "0 8px 24px rgba(0,0,0,0.25)" },
    "card": { "light": "0 6px 18px rgba(11,27,43,0.05)", "dark": "0 6px 18px rgba(0,0,0,0.20)" },
    "raised": { "light": "0 16px 40px rgba(11,27,43,0.08)", "dark": "0 16px 40px rgba(0,0,0,0.35)" },
    "avatar": { "light": "0 8px 20px rgba(11,27,43,0.10)", "dark": "0 8px 20px rgba(0,0,0,0.40)" },
    "pin": "0 6px 12px rgba(212,42,56,0.35)",
    "glass": { "light": "0 8px 32px rgba(11,27,43,0.10)", "dark": "0 8px 32px rgba(0,0,0,0.30)" }
  },

  "motion": {
    "duration": {
      "enter": "200ms",
      "enterMax": "240ms",
      "press": "120ms",
      "skeleton": "1400ms",
      "success": "1500ms",
      "dot": "1000ms"
    },
    "easing": {
      "enter": "cubic-bezier(0.22, 1, 0.36, 1)",
      "press": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    },
    "stagger": { "step": "50ms", "min": "40ms", "max": "500ms" },
    "enter": { "translateY": "8px", "fromOpacity": 0, "toOpacity": 1 },
    "press": { "scale": 0.97 },
    "loader": { "dotPulseBpm": 60 }
  },

  "layout": {
    "breakpoints": { "xs": "320px", "sm": "375px", "md": "414px", "tablet": "768px", "laptop": "1024px", "desktop": "1280px", "wide": "1440px", "max": "1920px", "4k": "2560px" },
    "maxContent": "1180px"
  },

  "z": {
    "base": 0, "raised": 10, "sticky": 100, "appBar": 200, "sheet": 300, "modal": 400, "toast": 500
  },

  "a11y": {
    "minTouchTarget": "44px",
    "minContrastText": 4.5,
    "minContrastLarge": 3,
    "focusRing": { "width": "3px", "color": { "light": "#D42A38", "dark": "#D7FF00" } }
  },

  "contrast": [
    { "id": "text.primary on bg.canvas", "fg": "text.primary", "bg": "bg.canvas", "min": 4.5, "kind": "text" },
    { "id": "text.primary on bg.surface", "fg": "text.primary", "bg": "bg.surface", "min": 4.5, "kind": "text" },
    { "id": "text.primary on bg.elevated", "fg": "text.primary", "bg": "bg.elevated", "min": 4.5, "kind": "text" },
    { "id": "text.primary on bg.sunken", "fg": "text.primary", "bg": "bg.sunken", "min": 4.5, "kind": "text" },
    { "id": "text.secondary on bg.canvas", "fg": "text.secondary", "bg": "bg.canvas", "min": 4.5, "kind": "text" },
    { "id": "text.secondary on bg.surface", "fg": "text.secondary", "bg": "bg.surface", "min": 4.5, "kind": "text" },
    { "id": "text.tertiary on bg.surface", "fg": "text.tertiary", "bg": "bg.surface", "min": 4.5, "kind": "text" },
    { "id": "text.onBrand on action.primary.bg", "fg": "text.onBrand", "bg": "action.primary.bg", "min": 4.5, "kind": "text" },
    { "id": "text.onAccent on action.accent.bg", "fg": "text.onAccent", "bg": "action.accent.bg", "min": 4.5, "kind": "text" },
    { "id": "text.onAccent on accent.lime", "fg": "text.onAccent", "bg": "accent.lime", "min": 4.5, "kind": "text" },
    { "id": "accent.lime on bg.inverse", "fg": "accent.lime", "bg": "bg.inverse", "min": 3, "kind": "icon" },
    { "id": "accent.lime on bg.canvas", "fg": "accent.lime", "bg": "bg.canvas", "min": 3, "kind": "icon", "themes": ["dark"] },
    { "id": "text.link on bg.canvas", "fg": "text.link", "bg": "bg.canvas", "min": 4.5, "kind": "text" },
    { "id": "text.link on bg.surface", "fg": "text.link", "bg": "bg.surface", "min": 4.5, "kind": "text" },
    { "id": "icon.primary on bg.surface", "fg": "icon.primary", "bg": "bg.surface", "min": 3, "kind": "icon" },
    { "id": "icon.secondary on bg.surface", "fg": "icon.secondary", "bg": "bg.surface", "min": 3, "kind": "icon" },
    { "id": "icon.onBrand on action.primary.bg", "fg": "icon.onBrand", "bg": "action.primary.bg", "min": 3, "kind": "icon" },
    { "id": "status.success.fg on status.success.bg", "fg": "status.success.fg", "bg": "status.success.bg", "min": 4.5, "kind": "text" },
    { "id": "status.warning.fg on status.warning.bg", "fg": "status.warning.fg", "bg": "status.warning.bg", "min": 4.5, "kind": "text" },
    { "id": "status.danger.fg on status.danger.bg", "fg": "status.danger.fg", "bg": "status.danger.bg", "min": 4.5, "kind": "text" },
    { "id": "status.info.fg on status.info.bg", "fg": "status.info.fg", "bg": "status.info.bg", "min": 4.5, "kind": "text" },
    { "id": "status.neutral.fg on status.neutral.bg", "fg": "status.neutral.fg", "bg": "status.neutral.bg", "min": 4.5, "kind": "text" },
    { "id": "service.pharmacy.glyph on service.pharmacy.bg", "fg": "service.pharmacy.glyph", "bg": "service.pharmacy.bg", "min": 4.5, "kind": "icon" },
    { "id": "service.consult.glyph on service.consult.bg", "fg": "service.consult.glyph", "bg": "service.consult.bg", "min": 4.5, "kind": "icon" },
    { "id": "service.lab.glyph on service.lab.bg", "fg": "service.lab.glyph", "bg": "service.lab.bg", "min": 4.5, "kind": "icon" },
    { "id": "service.radiology.glyph on service.radiology.bg", "fg": "service.radiology.glyph", "bg": "service.radiology.bg", "min": 4.5, "kind": "icon" },
    { "id": "service.nursing.glyph on service.nursing.bg", "fg": "service.nursing.glyph", "bg": "service.nursing.bg", "min": 4.5, "kind": "icon" },
    { "id": "service.mind.glyph on service.mind.bg", "fg": "service.mind.glyph", "bg": "service.mind.bg", "min": 4.5, "kind": "icon" },
    { "id": "service.nutrition.glyph on service.nutrition.bg", "fg": "service.nutrition.glyph", "bg": "service.nutrition.bg", "min": 4.5, "kind": "icon" },
    { "id": "service.family.glyph on service.family.bg", "fg": "service.family.glyph", "bg": "service.family.bg", "min": 4.5, "kind": "icon" },
    { "id": "text.onInverse on bg.inverse", "fg": "text.onInverse", "bg": "bg.inverse", "min": 4.5, "kind": "text" },
    { "id": "text.onInverseSecondary on bg.inverse", "fg": "text.onInverseSecondary", "bg": "bg.inverse", "min": 4.5, "kind": "text" },
    { "id": "text.onAccent on track.filled", "fg": "text.onAccent", "bg": "track.filled", "min": 4.5, "kind": "text" }
  ]
}
