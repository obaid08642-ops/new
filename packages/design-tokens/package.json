{
  "name": "@nabd/design-tokens",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Nabd+ design tokens \u2014 the single source of truth for colour, type, spacing, radius, shadow and motion across patient-web, patient-app, provider-app and admin.",
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check",
    "contrast": "node ../../tools/design/contrast-check.ts",
    "type-scale": "node ../../tools/design/no-px-font-size.ts",
    "test": "npm run check && npm run sync-web:check && npm run contrast && npm run type-scale && npm run no-emoji && npm run no-raw-color && npm run i18n-coverage",
    "no-raw-color": "node ../../tools/design/no-raw-color.ts",
    "no-emoji": "node ../../tools/design/no-emoji-in-ui.ts",
    "sync-web": "node ../../tools/design/sync-token-css.mjs",
    "sync-web:check": "node ../../tools/design/sync-token-css.mjs --check",
    "i18n-coverage": "node ../../tools/design/i18n-coverage.mjs"
  },
  "files": [
    "dist",
    "tokens.json"
  ],
  "exports": {
    ".": "./dist/ts/tokens.ts",
    "./tokens.json": "./tokens.json",
    "./dist/css/tokens.css": "./dist/css/tokens.css",
    "./dist/css/fonts.css": "./dist/css/fonts.css",
    "./dist/ts/tokens.ts": "./dist/ts/tokens.ts",
    "./dist/tailwind-preset.cjs": "./dist/tailwind-preset.cjs",
    "./*": "./*"
  }
}
