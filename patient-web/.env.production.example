# Nabd Plus patient web — production example
# Copy to .env.production on the deployment host and replace only with approved values.
# Never commit .env.production or paste secrets into this file.

# Server-side BFF upstream. Keep this URL server-only; do not expose it as NEXT_PUBLIC_*.
NABD_API_BASE_URL=https://api.nabd.plus/api/v1

# Canonical public origin used for metadata and absolute links.
NEXT_PUBLIC_SITE_ORIGIN=https://nabd.plus

# Optional local gates; keep disabled in production unless an approved test run is active.
RUN_SANDBOX_TESTS=false
RUN_SANDBOX_CREDENTIAL_TEST=false
# NABD_SANDBOX_OWNER_EMAIL=
# NABD_SANDBOX_OWNER_PASSWORD=
# NABD_SANDBOX_OTHER_EMAIL=
# NABD_SANDBOX_OTHER_PASSWORD=

# Google sign-in (patient web). OAuth Web Client ID from Google Cloud Console.
# When unset, the Google button is hidden and guest login remains available.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
