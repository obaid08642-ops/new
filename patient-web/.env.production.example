# Nabd Plus patient web — production example
# Copy to .env.production on the deployment host and replace only with approved values.
# Never commit .env.production or paste secrets into this file.

# Server-side BFF upstream. Keep this URL server-only; do not expose it as NEXT_PUBLIC_*.
NABD_API_BASE_URL=https://api.nabd.plus/api/v1

# Canonical public origin used for metadata and absolute links.
NEXT_PUBLIC_SITE_ORIGIN=https://nabd.plus

# Optional local gates; keep disabled in production unless an approved test run is active.
RUN_SANDBOX_TESTS=false
RUN_SANDBOX_CREDENTIAL_TEST=false
# NABD_SANDBOX_OWNER_EMAIL=
# NABD_SANDBOX_OWNER_PASSWORD=
# NABD_SANDBOX_OTHER_EMAIL=
# NABD_SANDBOX_OTHER_PASSWORD=

# Social sign-in (patient web; all providers, owner decision 2026-10-24). The login page reads GET /auth/social/config from the BACKEND at
# run time: a button shows when the backend has that provider's credentials (set them on the backend, see backend/.env.example; no web
# rebuild). The values below are only a FALLBACK for a backend that does not answer that endpoint.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# NEXT_PUBLIC_APPLE_CLIENT_ID=
# NEXT_PUBLIC_APPLE_REDIRECT_URI=
# NEXT_PUBLIC_X_CLIENT_ID=
# NEXT_PUBLIC_SNAPCHAT_CLIENT_ID=
# NEXT_PUBLIC_SOCIAL_X_SNAPCHAT=1

# Where a doctor/pharmacy/lab account is sent when it signs in on the patient site (https only; each is hidden when unset).
# NEXT_PUBLIC_PROVIDER_WEB_URL=
# NEXT_PUBLIC_PROVIDER_APP_IOS_URL=
# NEXT_PUBLIC_PROVIDER_APP_ANDROID_URL=

# Apple sign-in (patient web). The Services ID created at developer.apple.com for the web origin. When unset, the Apple button is hidden.
# NEXT_PUBLIC_APPLE_CLIENT_ID=
# One of the Return URLs registered for that Services ID (defaults to this site's origin).
# NEXT_PUBLIC_APPLE_REDIRECT_URI=

# Sentry error monitoring (patient-web project). Empty in dev disables monitoring.
NEXT_PUBLIC_SENTRY_DSN=

# 14.8: shared secret for POST /api/revalidate (the backend PurgeBus). Unset = the endpoint answers 503.
NEXT_REVALIDATE_SECRET=
