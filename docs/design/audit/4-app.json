          "GET /insurance/coverage-check (provider, policy); GET /users/me/profile (saved policy check on send)",
          "ok"
        ],
        [
          "Price summary",
          "nurse.price x days (estimate; backend recomputes)",
          "ok"
        ],
        [
          "Confirm booking",
          "POST /nursing/bookings, then POST /payments/intent/nursing/:param (unchanged)",
          "ok"
        ],
        [
          "Insurance request sent result",
          "POST /nursing/bookings answered",
          "ok"
        ],
        [
          "Invented '(0 SAR)' transport price",
          "removed",
          "fixed"
        ]
