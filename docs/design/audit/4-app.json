        [
          "Sort sheet",
          "user input; re-queries with sort=",
          "ok"
        ],
        [
          "Select nurse",
          "navigation; injection services show the prescription dialog first",
          "ok"
        ],
        [
          "Hero claims (ministry supervision, instant response, full coverage)",
