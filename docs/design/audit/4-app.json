      "elements": [
        [
          "Title and my-visits pill",
          "static keys; opens /nursing/visits",
          "ok"
        ],
        [
          "Search field",
          "user input; passed on to service-details, no local filtering",
          "ok"
        ],
        [
          "Filter sheet (gender, availability, nationality)",
          "user input; passed on to service-details",
          "ok"
        ],
        [
          "Insurance / cash toggle",
          "user input (flow param)",
          "ok"
        ],
        [
          "Care packages strip",
          "GET /home-care/packages (name_ar/title, type, duration, price when sent)",
          "ok"
        ],
        [
          "Services grid (image, name, description, price, book now)",
          "GET /home-care/services",
          "ok"
        ],
        [
          "Loading / error / offline / empty states",
          "calls above; ErrorState with retry",
          "ok"
        ],
        [
          "Raw colours, blur header, stock gradient card",
          "removed (tokens only)",
          "fixed"
        ]
      ]
    },
    {
      "route": "/nursing/insurance-status",
      "elements": [
