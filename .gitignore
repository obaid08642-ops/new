# Dependencies
node_modules/
.pnpm-store/

# Build artifacts
dist/
build/
.next/
.turbo/
.cache/
out/

# The design system packages are the exception: dist/ is GENERATED but
# COMMITTED, so patient-web, patient-app, provider-app and admin can consume it
# without a build step. CI runs `npm run check` in each package to fail if it
# drifts from its source of truth.
!packages/design-tokens/dist/
!packages/brand/dist/

# @nabd/ui's dist/ holds the GENERATED icon sheets and the preview page, which
# the design review reads directly. Committed like the other two, and `npm run
# check` in the package fails if it drifts from the source geometry.
!packages/ui/dist/

# Environment and secrets
.env*.local
*.pem
*.key

# Test & coverage
coverage/
.nyc_output/

# Logs & temp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
extracted/

# Filled production secrets (deploy/scripts/deploy.sh writes it)
deploy/.env.production
dump.rdb
patient-web/public/openapi.json

# Rendered coturn config holds the live TURN secret (deploy/scripts/render-coturn-config.sh)
deploy/coturn/turnserver.rendered.conf
