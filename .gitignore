# Dependencies
node_modules/
.pnpm-store/

# Build artifacts
dist/
build/
.next/
.turbo/
.cache/
out/

# The design tokens are the exception: dist/ is GENERATED but COMMITTED, so
# patient-web, patient-app, provider-app and admin can import the system
# without a build step. CI runs `npm run check` in packages/design-tokens to
# fail if it drifts from tokens.json.
!packages/design-tokens/dist/

# Environment and secrets
.env*.local
*.pem
*.key

# Test & coverage
coverage/
.nyc_output/

# Logs & temp
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
extracted/

# Filled production secrets (deploy/scripts/deploy.sh writes it)
deploy/.env.production
dump.rdb
patient-web/public/openapi.json
