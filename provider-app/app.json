{
  "expo": {
    "name": "Nabd Plus Provider",
    "slug": "nabd-plus-provider",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "nabdplus-provider",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nabd.provider",
      "infoPlist": {
        "NSCameraUsageDescription": "نحتاج الكاميرا لرفع مستندات المزوّد والتحقق من الهوية.",
        "NSMicrophoneUsageDescription": "نحتاج الميكروفون للمكالمات الصوتية والمرئية.",
        "NSLocationWhenInUseUsageDescription": "نحتاج الموقع لتتبع الزيارات المنزلية وتطبيق geofence.",
        "NSPhotoLibraryUsageDescription": "نحتاج الصور لرفع التقارير والمستندات.",
        "UIBackgroundModes": ["remote-notification"],
        "NSFaceIDUsageDescription": "نستخدم التحقق الحيوي لتسجيل الدخول بشكل آمن."
      }
    },
    "android": {
      "package": "com.nabd.provider",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FF4B55"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ]
    },
    "plugins": [
      ["expo-splash-screen", { "image": "./assets/splash.png", "resizeMode": "contain", "backgroundColor": "#F5F5F7" }],
      ["expo-build-properties", { "android": { "usesCleartextTraffic": false } }],
      "expo-font",
      "expo-secure-store",
      "expo-camera",
      ["expo-notifications", { "sounds": ["./assets/sounds/new_order.wav"], "defaultChannel": "default", "color": "#D42A38" }],
      "expo-location",
      "expo-local-authentication",
      "@react-native-community/datetimepicker",
      [
        "@sentry/react-native",
        {
          "url": "https://de.sentry.io/",
          "organization": "nabdplus",
          "project": "provider-app"
        }
      ],
      "@maplibre/maplibre-react-native"
    ],
    "extra": {
      "apiBaseUrl": "https://api.nabd.plus/api/v1"
    },
    "icon": "./assets/icon.png",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
