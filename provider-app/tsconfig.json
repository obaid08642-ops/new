{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": false,
    "skipLibCheck": true,
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-native",
    "lib": [
      "es2020",
      "dom"
    ],
    "moduleResolution": "bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "target": "ESNext",
    "types": [
      "jest"
    ],
    "paths": {
      "@nabd/ui-native": [
        "../packages/ui-native/src/Icon.tsx"
      ],
      "@nabd/ui/icons/illustrated": [
        "../packages/ui/icons/illustrated.ts"
      ],
      "@nabd/ui/icons/illustrations": [
        "../packages/ui/icons/illustrations.ts"
      ],
      "@nabd/ui/icons/names": [
        "../packages/ui/icons/names.ts"
      ],
      "@nabd/ui/components/contract": [
        "../packages/ui/components/contract.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
