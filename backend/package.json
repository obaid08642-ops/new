{
  "name": "nabd-backend",
  "version": "1.0.0",
  "description": "Nabd Healthcare Super Platform - NestJS Core Backend",
  "private": true,
  "scripts": {
    "build": "nest build && npm run openapi:generate",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node scripts/run-tests-chunked.mjs",
    "test:boot": "jest --config jest.boot.config.js --runInBand",
    "migration:hospital-staff-parent-account": "ts-node scripts/migrate-hospital-staff-parent-account.ts",
    "test:enterprise": "jest --config jest.enterprise.config.js --runInBand --detectOpenHandles",
    "openapi:generate": "ts-node -T scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.7",
    "@google/generative-ai": "^0.24.1",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/cqrs": "11.0.3",
    "@nestjs/event-emitter": "3.1.0",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mongoose": "11.0.4",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/platform-fastify": "11.2.7",
    "@nestjs/platform-socket.io": "11.2.1",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "11.2.1",
    "@sentry/nestjs": "^10.74.0",
    "@sentry/profiling-node": "^10.74.0",
    "@simplewebauthn/server": "^13.2.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/supertest": "^7.2.1",
    "axios": "^1.21.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.80.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "exceljs": "4.4.0",
    "express-mongo-sanitize": "^2.2.0",
    "fastify": "^5.12.8",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.2.0",
    "ioredis": "^6.0.0",
    "libphonenumber-js": "^1.13.15",
    "livekit-server-sdk": "^2.19.2",
    "lru-cache": "^11.1.0",
    "mongoose": "^8.7.0",
    "nest-winston": "^1.10.2",
    "nodemailer": "^9.0.3",
    "opossum": "^9.0.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.37.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "supertest": "^7.3.1",
    "uuid": "^10.0.0",
    "web-push": "^3.6.7",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.1",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^8.0.1",
    "@types/opossum": "^8.1.9",
    "@types/pdfkit": "^0.17.7",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.14.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "socket.io-client": "^4.8.4",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/../test/jest-env.js"
    ]
  },
  "overrides": {
    "multer": "^2.5.0"
  }
}
