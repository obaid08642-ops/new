    "helmet": "^8.2.0",
    "ioredis": "^5.3.2",
    "livekit-server-sdk": "^2.17.0",
    "mongoose": "^8.7.0",
    "nest-winston": "^1.10.2",
    "nodemailer": "^9.0.3",
    "passport": "^0.7.0",
