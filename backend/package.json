{
  "name": "nabd-backend",
  "version": "1.0.0",
  "description": "Nabd Healthcare Super Platform - NestJS Core Backend",
  "private": true,
  "scripts": {
    "build": "nest build && npm run openapi:generate",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "node scripts/run-tests-chunked.mjs",
    "test:boot": "jest --config jest.boot.config.js --runInBand",
    "migration:hospital-staff-parent-account": "ts-node scripts/migrate-hospital-staff-parent-account.ts",
    "test:enterprise": "jest --config jest.enterprise.config.js --runInBand --detectOpenHandles",
    "openapi:generate": "ts-node -T scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@aws-sdk/s3-request-presigner": "^3.1075.0",
