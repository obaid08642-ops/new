    "@sentry/nestjs": "^10.74.0",
    "@sentry/profiling-node": "^10.74.0",
    "@simplewebauthn/server": "^13.2.2",
    "@types/supertest": "^7.2.1",
    "axios": "^1.18.1",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "bullmq": "^5.80.2",
    "clamav.js": "^0.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
