FROM node:26.12.0-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci --legacy-peer-deps
COPY . .
RUN npm run build

FROM node:26.12.0-alpine
WORKDIR /app
COPY --from=builder /app/dist ./dist
COPY package*.json ./
RUN npm ci --only=production --legacy-peer-deps
EXPOSE 8002
CMD ["node", "dist/main.js"]
