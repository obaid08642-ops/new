# ══════════════════════════════════════════════════════════════
# Nabdah Plus — Complete Production Environment Variables
# Copy this file to .env and fill in actual values
# ══════════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────────
PORT=8002
NODE_ENV=production

# ── MongoDB ────────────────────────────────────────────────────
MONGO_URL=mongodb://admin:changeme@mongodb:27017
DB_NAME=nabd
MONGO_USER=admin
MONGO_PASS=changeme

# ── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://:changeme@redis:6379
REDIS_PASSWORD=changeme

# ── JWT Auth ───────────────────────────────────────────────────
JWT_SECRET=CHANGE_TO_LONG_RANDOM_STRING_MIN_64_CHARS
JWT_EXPIRES_IN=30d

# ── LiveKit (Self-hosted) ──────────────────────────────────────
# Get from your self-hosted LiveKit server config
LIVEKIT_URL=wss://livekit.yourdomain.com
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET

# ── Coturn (Self-hosted STUN/TURN) ─────────────────────────────
COTURN_HOST=turn.yourdomain.com
COTURN_SECRET=CHANGE_TO_SECURE_COTURN_SECRET
COTURN_STUN_PORT=3478
COTURN_TURN_PORT=3478

# ── Firebase (FCM Push Notifications) ─────────────────────────
# Service account JSON from Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"YOUR_PROJECT_ID",...}
FCM_SERVER_KEY=YOUR_FCM_SERVER_KEY

# ── Email OTP (Gmail SMTP) ─────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASS=xxxx_xxxx_xxxx_xxxx

# ── Gemini AI ─────────────────────────────────────────────────
GEMINI_KEY_OCR=AIzaSy...your_ocr_key
GEMINI_KEY_CLINICAL=AIzaSy...your_clinical_key
GEMINI_KEY_NUTRITION=AIzaSy...your_nutrition_key

# ── Google Maps ────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=AIzaSy...your_maps_key

# ── Moyasar Payment ────────────────────────────────────────────
# Get from: https://dashboard.moyasar.com/apikeys
MOYASAR_API_KEY=sk_test_YOUR_MOYASAR_KEY
MOYASAR_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY

# ── Cloudflare R2 Storage ──────────────────────────────────────
CLOUDFLARE_R2_ACCESS_KEY=your_r2_access_key
CLOUDFLARE_R2_SECRET_KEY=your_r2_secret_key
CLOUDFLARE_R2_BUCKET=nabdah-assets
CLOUDFLARE_R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://pub-XXXX.r2.dev

# ── Sentry Error Tracking ──────────────────────────────────────
SENTRY_DSN=https://YOUR_SENTRY_DSN@sentry.io/PROJECT_ID

# ── FastAPI Companion (AI/OCR) ─────────────────────────────────
FASTAPI_URL=http://localhost:8000

# ── Admin UI ───────────────────────────────────────────────────
ADMIN_UI_USER=admin
ADMIN_UI_PASS=changeme

# ── Public URLs ────────────────────────────────────────────────
PUBLIC_APP_URL=https://api.yourdomain.com
APP_DEEP_LINK=nabd://
