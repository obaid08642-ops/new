# Backend environment (development). Production values live in deploy/.env.production.example.
# Only the logging variables are listed here; see docs/ops/LOGS_20.3.md.

# 20.3: debug | info | warn | error. Default: debug in development, info when NODE_ENV=production.
# An unknown value falls back to that default (a typo never silences the logs).
LOG_LEVEL=debug

# warn and error lines are also stored in Mongo `app_logs` (30-day TTL index) and read at admin > Logs.
# LOG_STORE=off                 # do not store them (stdout only)
# LOG_STORE_MAX_MB=256          # size cap: the oldest lines are deleted above this
# LOG_STORE_MAX_DOCS=200000     # count cap
# LOG_STORE_RATE_PER_MIN=600    # per process; an error storm cannot flood the database

# 19.7 Saudi Post National Address lookup. SPL_API_URL has {code} (and optionally {key}) in it; answer: { "Addresses": [ { BuildingNumber, Street, District, City, RegionName, PostCode, AdditionalNumber, Latitude, Longitude } ] }.
# Unset: a short address is saved but not marked verified.
SPL_API_URL=
SPL_API_KEY=
