# Backend environment (development). Production values live in deploy/.env.production.example.
# Only the logging variables are listed here; see docs/ops/LOGS_20.3.md.

# 20.3: debug | info | warn | error. Default: debug in development, info when NODE_ENV=production.
# An unknown value falls back to that default (a typo never silences the logs).
LOG_LEVEL=debug

# warn and error lines are also stored in Mongo `app_logs` (30-day TTL index) and read at admin > Logs.
# LOG_STORE=off                 # do not store them (stdout only)
# LOG_STORE_MAX_MB=256          # size cap: the oldest lines are deleted above this
# LOG_STORE_MAX_DOCS=200000     # count cap
# LOG_STORE_RATE_PER_MIN=600    # per process; an error storm cannot flood the database

# 19.3 SCFHS licence verification (doctors, pharmacists, individual nurses). The service answers JSON
# { "found": bool, "status": "active|expired|suspended|revoked", "expiry_date": "YYYY-MM-DD", "holder_name"?: string }
# for GET <SCFHS_VERIFY_URL>?license_number=<n>. Unset: nobody is verified automatically; approval needs the admin's manual check.
SCFHS_VERIFY_URL=
SCFHS_API_KEY=
# Days an SCFHS outage is tolerated before a provider is hidden (default 14).
SCFHS_RECHECK_GRACE_DAYS=14
# 19.7 Saudi Post National Address lookup. SPL_API_URL has {code} (and optionally {key}) in it; answer: { "Addresses": [ { BuildingNumber, Street, District, City, RegionName, PostCode, AdditionalNumber, Latitude, Longitude } ] }.
# Unset: a short address is saved but not marked verified.
SPL_API_URL=
SPL_API_KEY=
# 16.5 Antivirus for uploads: a ClamAV daemon (clamd). Streamed with INSTREAM; nothing touches the disk.
# An infected file is always refused. UPLOAD_SCAN=required (the production default) also refuses uploads while clamd cannot answer;
# optional lets them through (a developer machine without ClamAV).
CLAMD_HOST=
CLAMD_PORT=3310
# CLAMD_SOCKET=/var/run/clamav/clamd.ctl   (instead of host/port)
UPLOAD_SCAN=optional
# 16.9: health data is encrypted at rest (AES-256-GCM) when this is set: 32 random bytes, base64 or hex. Unset = stored in clear text.
# FIELD_ENCRYPTION_KEY=
# FIELD_ENCRYPTION_KEY_PREVIOUS=   # after a rotation, comma separated, decrypt only
# MEDICAL_ACCESS_LOG_RETENTION_DAYS=1825

# Social sign-in. The clients read GET /auth/social/config at run time: a button shows when the backend has that provider's
# credentials, no web or app rebuild. Only PUBLIC ids and redirect URIs are ever returned; secrets never are.
# Google: audiences the backend accepts (comma list: web, iOS and Android client ids). Optional: GOOGLE_WEB_CLIENT_ID, GOOGLE_IOS_CLIENT_ID,
# GOOGLE_ANDROID_CLIENT_ID say which one each client uses (each must also be in the list; default for the web: the first).
# GOOGLE_OAUTH_CLIENT_IDS=
# Apple: audiences (the Services ID of the web and the app bundle id). The web button also needs APPLE_REDIRECT_URI (https) and uses
# APPLE_WEB_CLIENT_ID (default: the first of the list).
# APPLE_SIGNIN_CLIENT_IDS=
# APPLE_WEB_CLIENT_ID=
# APPLE_REDIRECT_URI=
# X and Snapchat (OAuth2 code + PKCE; the backend exchanges the code with the secret). SOCIAL_REDIRECT_URIS is the allow-list of the
# redirect URIs the clients use: https://<site>/<locale>/login/social-callback for each of ar,en,ur,hi,bn,fil (the web popup), the app's
# X redirect (nabdplus://), and the app's Snapchat redirect https://nabd.plus/en/login/app-callback (Snapchat accepts HTTPS only; that page
# hands the code to nabdplus://login/app-callback). Snapchat also needs the scopes user.display_name and user.external_id on its app.
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# SNAPCHAT_CLIENT_ID=
# SNAPCHAT_CLIENT_SECRET=
# SOCIAL_REDIRECT_URIS=
# Per-provider switch: GOOGLE_SIGNIN_ENABLED, APPLE_SIGNIN_ENABLED, X_SIGNIN_ENABLED, SNAPCHAT_SIGNIN_ENABLED. Unset = on when the
# credentials are set; false / 0 / off / no turns that provider off.
