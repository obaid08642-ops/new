{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      {
        "include": "assets/**/*"
      },
      {
        "include": "modules/catalogs/seed-data/*.json",
        "watchAssets": false
      }
    ]
  }
}
