# ── Stage 1: install + build ──────────────────────────────────────
FROM node:20-bookworm-slim AS builder
WORKDIR /usr/src/app
COPY package.json package-lock.json* ./
RUN npm ci --no-audit --no-fund || npm install --no-audit --no-fund
COPY . .
ENV NEXT_TELEMETRY_DISABLED=1
ARG NEXT_PUBLIC_API_URL=https://api.nabd.plus
ARG NEXT_PUBLIC_WS_URL=https://api.nabd.plus
ARG NEXT_PUBLIC_SITE_URL=https://admin.nabd.plus
ARG NEXT_PUBLIC_APP_NAME="Nabdah Plus Admin"
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL NEXT_PUBLIC_WS_URL=$NEXT_PUBLIC_WS_URL NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL NEXT_PUBLIC_APP_NAME=$NEXT_PUBLIC_APP_NAME
RUN npm run build

# ── Stage 2: run ──────────────────────────────────────────────────
FROM node:20-bookworm-slim AS production
WORKDIR /usr/src/app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1
RUN apt-get update && apt-get install -y --no-install-recommends wget \
  && rm -rf /var/lib/apt/lists/*
COPY --from=builder /usr/src/app/package.json ./
COPY --from=builder /usr/src/app/node_modules ./node_modules
COPY --from=builder /usr/src/app/.next ./.next
COPY --from=builder /usr/src/app/public ./public
COPY --from=builder /usr/src/app/next.config.* ./
RUN groupadd -r nextjs && useradd -r -g nextjs nextjs && chown -R nextjs:nextjs /usr/src/app
USER nextjs
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=5 \
  CMD wget -qO- http://localhost:3000/ || exit 1
CMD ["npx", "next", "start", "-p", "3000"]
