# ═══════════════════════════════════════════════════════════════════
# Nabdah Plus — production environment (copied to .env.production by scripts/deploy.sh)
# __NAME__ markers are replaced with fresh secrets on the first deploy.
# Third-party keys are left EMPTY on purpose: an empty key makes that feature
# answer 503 "not configured" instead of pretending to work. Never write
# placeholders like "pending_real_key" (the backend strips them at boot anyway).
# File mode must stay 600. Never commit the filled copy.
# ═══════════════════════════════════════════════════════════════════

# ── Core (required: the backend refuses to boot in production without these) ──
NODE_ENV=production
# 20.3 logging: debug|info|warn|error. Default info in production (debug in development). Lines are JSON on stdout
# (docker json-file, 20m x 3); warn and error are also kept 30 days in Mongo `app_logs` and shown in the admin dashboard
# (Logs). Optional knobs: LOG_STORE=off (do not store), LOG_STORE_MAX_MB=256, LOG_STORE_MAX_DOCS=200000, LOG_STORE_RATE_PER_MIN=600.
LOG_LEVEL=info
DB_NAME=nabd_nestjs
MONGO_ROOT_USER=nabdah_root
MONGO_ROOT_PASSWORD=__MONGO_ROOT_PASSWORD__
REDIS_PASSWORD=__REDIS_PASSWORD__
# D-29 search engine (self-hosted Meilisearch). Generate: openssl rand -hex 32
MEILI_MASTER_KEY=__MEILI_MASTER_KEY__
# MONGO_URL / REDIS_URL are composed in docker-compose.production.yml from the values above.
# P14.14, scale step 2 only: a second Redis with allkeys-lru for rebuildable cache entries (HotCache). Empty = one Redis.
REDIS_CACHE_URL=
# #1603: memory of the cache-only Redis (docker-compose `redis-cache`): the Next.js page cache of patient-web. Evicts the least
# recently used page when full. ~80 KB per product page, so 256mb keeps the ~3,000 hottest pages. To also move the backend's
# HotCache there: REDIS_CACHE_URL=redis://:${REDIS_PASSWORD}@redis-cache:6379 (the backend must then join the `cache` network).
REDIS_CACHE_MAXMEMORY=256mb
JWT_SECRET=__JWT_SECRET__
# Exact origins, comma-separated, no wildcard (boot fails on "*").
ALLOWED_ORIGINS=https://nabd.plus,https://www.nabd.plus,https://admin.nabd.plus,https://provider.nabd.plus
CORS_ORIGINS=https://nabd.plus,https://www.nabd.plus,https://admin.nabd.plus,https://provider.nabd.plus
PUBLIC_APP_URL=https://nabd.plus
WEB_PUBLIC_URL=https://nabd.plus
API_PUBLIC_URL=https://api.nabd.plus
NABD_PUBLIC_URL=https://nabd.plus
PROVIDER_APP_BASE_URL=https://provider.nabd.plus
SWAGGER_ENABLED=false

# ── MUST stay unset in production (test/load-test switches) ──
# LOAD_TEST_BYPASS_TOKEN=
# ALLOW_TEST_SEED=
# DISABLE_RATE_LIMIT=
# USE_MEMORY_MONGO=
# SEED_DEMO_DATA=

# ── Realtime video (LiveKit + coturn) ──
LIVEKIT_URL=wss://live.nabd.plus
LIVEKIT_API_KEY=__LIVEKIT_API_KEY__
LIVEKIT_API_SECRET=__LIVEKIT_API_SECRET__
COTURN_SECRET=__COTURN_SECRET__
COTURN_REALM=nabd.plus
COTURN_HOST=turn.nabd.plus
TURN_REALM=nabd.plus

# ── Web push ──
WEB_PUSH_VAPID_PUBLIC_KEY=__VAPID_PUBLIC__
WEB_PUSH_VAPID_PRIVATE_KEY=__VAPID_PRIVATE__
WEB_PUSH_VAPID_SUBJECT=mailto:support@nabd.plus

# ── Payments (empty = payment endpoints return 503 payment_gateway_not_configured) ──
MOYASAR_API_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
TAP_API_KEY=
STRIPE_SECRET_KEY=
VAT_PERCENTAGE=15
ZATCA_SELLER_NAME=
ZATCA_VAT_NUMBER=

# ── Storage (Cloudflare R2 / S3-compatible) ──
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
# Off-server backups (D-33): a SEPARATE PRIVATE bucket with its own key, never the public S3_BUCKET above.
# Copies expire after 30 days (deploy/scripts/backup-bucket-lifecycle.sh).
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# 20.8: AES-256 key for oplog slices and the off-server dump (openssl rand -hex 32). Keep a copy OFF the server (owner safe):
# without it the off-server backups cannot be read.
BACKUP_ENCRYPTION_KEY=
# Backup runs are reported to the admin page (D-34): POST <BACKUP_REPORT_URL>/api/v1/ops/backup-runs
BACKUP_REPORT_URL=
BACKUP_REPORT_TOKEN=

# ── Email ──
RESEND_API_KEY=
MAIL_FROM=
# deploy/scripts/monitor.sh mails its alerts here (disk under 20% free, a container down, an old backup); empty = logged only
OPS_ALERT_EMAIL=
SES_SMTP_HOST=
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=
SES_FROM=

# ── SMS / OTP ──
SMS_ENABLED=false
TAQNYAT_API_KEY=
INFOBIP_API_KEY=
INFOBIP_URL=
INFOBIP_SENDER=
UNIFONIC_APP_ID=

# ── Push (Firebase / APNs) ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
APNS_TEAM_ID=6AT2W85DBC
APNS_KEY_ID=
APNS_AUTH_KEY=
APNS_BUNDLE_ID=
APNS_HOST=api.push.apple.com

# ── AI (empty = AI endpoints return 503 ai_provider_unavailable) ──
AI_PROVIDER=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── Monitoring ──
SENTRY_DSN=
APP_VERSION=

# ── Instant purge (14.8): a catalogue change purges Cloudflare by Cache-Tag and Next by revalidateTag ──
# Unset = the purge logs "purge medicines failed: ..._missing_credentials" on every catalogue write.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
NEXT_REVALIDATE_URL=https://nabd.plus/api/revalidate
# Same value as patient-web NEXT_REVALIDATE_SECRET.
NEXT_REVALIDATE_SECRET=

# ── Observability (Phase 20) ──
# Bearer token Prometheus sends to GET /api/v1/observability/metrics and /summary (at least 32 characters,
# e.g. `openssl rand -hex 32`). Empty = both routes answer 404; /observability/health-slo stays public.
METRICS_SCRAPE_TOKEN=
# P14.9: the edge HTML worker's shared secret (also the worker secret EDGE_STAMP_TOKEN); empty = edge mode off
NABD_EDGE_STAMP_TOKEN=
