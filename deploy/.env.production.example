# ═══════════════════════════════════════════════════════════════════
# Nabdah Plus — production environment (copied to .env.production by scripts/deploy.sh)
# __NAME__ markers are replaced with fresh secrets on the first deploy.
# Third-party keys are left EMPTY on purpose: an empty key makes that feature
# answer 503 "not configured" instead of pretending to work. Never write
# placeholders like "pending_real_key" (the backend strips them at boot anyway).
# File mode must stay 600. Never commit the filled copy.
# ═══════════════════════════════════════════════════════════════════

# ── Core (required: the backend refuses to boot in production without these) ──
NODE_ENV=production
DB_NAME=nabd_nestjs
MONGO_ROOT_USER=nabdah_root
MONGO_ROOT_PASSWORD=__MONGO_ROOT_PASSWORD__
REDIS_PASSWORD=__REDIS_PASSWORD__
# MONGO_URL / REDIS_URL are composed in docker-compose.production.yml from the values above.
JWT_SECRET=__JWT_SECRET__
# Exact origins, comma-separated, no wildcard (boot fails on "*").
ALLOWED_ORIGINS=https://nabd.plus,https://www.nabd.plus,https://admin.nabd.plus,https://provider.nabd.plus
CORS_ORIGINS=https://nabd.plus,https://www.nabd.plus,https://admin.nabd.plus,https://provider.nabd.plus
PUBLIC_APP_URL=https://nabd.plus
WEB_PUBLIC_URL=https://nabd.plus
API_PUBLIC_URL=https://api.nabd.plus
NABD_PUBLIC_URL=https://nabd.plus
PROVIDER_APP_BASE_URL=https://provider.nabd.plus
SWAGGER_ENABLED=false

# ── MUST stay unset in production (test/load-test switches) ──
# LOAD_TEST_BYPASS_TOKEN=
# ALLOW_TEST_SEED=
# DISABLE_RATE_LIMIT=
# USE_MEMORY_MONGO=
# SEED_DEMO_DATA=

# ── Realtime video (LiveKit + coturn) ──
LIVEKIT_URL=wss://live.nabd.plus
LIVEKIT_API_KEY=__LIVEKIT_API_KEY__
LIVEKIT_API_SECRET=__LIVEKIT_API_SECRET__
COTURN_SECRET=__COTURN_SECRET__
COTURN_REALM=nabd.plus
COTURN_HOST=turn.nabd.plus
TURN_REALM=nabd.plus

# ── Web push ──
WEB_PUSH_VAPID_PUBLIC_KEY=__VAPID_PUBLIC__
WEB_PUSH_VAPID_PRIVATE_KEY=__VAPID_PRIVATE__
WEB_PUSH_VAPID_SUBJECT=mailto:support@nabd.plus

# ── Payments (empty = payment endpoints return 503 payment_gateway_not_configured) ──
MOYASAR_API_KEY=
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=
TAP_API_KEY=
STRIPE_SECRET_KEY=
VAT_PERCENTAGE=15
ZATCA_SELLER_NAME=
ZATCA_VAT_NUMBER=

# ── Storage (Cloudflare R2 / S3-compatible) ──
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ── Email ──
RESEND_API_KEY=
MAIL_FROM=
SES_SMTP_HOST=
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASS=
SES_FROM=

# ── SMS / OTP ──
SMS_ENABLED=false
TAQNYAT_API_KEY=
INFOBIP_API_KEY=
INFOBIP_URL=
INFOBIP_SENDER=
UNIFONIC_APP_ID=

# ── Push (Firebase / APNs) ──
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
APNS_TEAM_ID=6AT2W85DBC
APNS_KEY_ID=
APNS_AUTH_KEY=
APNS_BUNDLE_ID=
APNS_HOST=api.push.apple.com

# ── AI (empty = AI endpoints return 503 ai_provider_unavailable) ──
AI_PROVIDER=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# ── Monitoring ──
SENTRY_DSN=
APP_VERSION=
