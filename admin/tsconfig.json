{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@nabd/ui": [
        "../packages/ui/src/index.ts"
      ],
      "@nabd/ui/icons/illustrated": [
        "../packages/ui/icons/illustrated.ts"
      ],
      "@nabd/ui/icons/illustrations": [
        "../packages/ui/icons/illustrations.ts"
      ],
      "@nabd/ui/icons/names": [
        "../packages/ui/icons/names.ts"
      ],
      "@nabd/ui/components/contract": [
        "../packages/ui/components/contract.ts"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": "."
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "acceptance"
  ]
}
