+import { BadRequestException, ForbiddenException, Injectable, NotFoundException } from '@nestjs/common';
+import { InjectModel } from '@nestjs/mongoose';
+import { Model } from 'mongoose';
+import { PharmacyOrderState } from '../schemas/pharmacy.schema';
+
+const DECISION_OUTCOMES = new Set(['full', 'partial', 'rejected']);
+const ITEM_OUTCOMES = new Set(['covered', 'rejected']);
+
+/**
+ * Internal/manual insurance decision for one immutable patient-selected offer.
+ * Monetary figures are never accepted from the request: this command derives
+ * them from the selected offer snapshot and persists an outbox intent first.
+ */
+@Injectable()
+export class PharmacyInsuranceDecisionService {
+  constructor(
+    @InjectModel('PharmacyOrder') private readonly orders: Model<any>,
+    @InjectModel('PharmacyOffer') private readonly offers: Model<any>,
+  ) {}
+
+  async decide(admin: any, orderId: string, body: any) {
+    if (!admin?.id || !['admin', 'super_admin'].includes(String(admin.role))) throw new ForbiddenException('internal_insurance_reviewer_required');
+    const outcome = String(body?.outcome || '').toLowerCase();
+    const idempotencyKey = String(body?.idempotency_key || '').trim();
+    const approvalReference = String(body?.approval_reference || '').trim();
+    const reason = String(body?.reason || '').trim();
+    if (!DECISION_OUTCOMES.has(outcome)) throw new BadRequestException('insurance_outcome_must_be_full_partial_or_rejected');
+    if (!/^[A-Za-z0-9._:-]{16,128}$/.test(idempotencyKey)) throw new BadRequestException('idempotency_key_required');
+    if (!approvalReference || approvalReference.length > 160) throw new BadRequestException('approval_reference_required');
+    if ((outcome === 'partial' || outcome === 'rejected') && !reason) throw new BadRequestException('decision_reason_required');
+
+    const order: any = await this.orders.findOne({ id: orderId });
+    if (!order) throw new NotFoundException('order_not_found');
+    if (String(order.payment_method || order.payment?.method || '').toLowerCase() !== 'insurance' && !order.insurance_details) {
+      throw new BadRequestException('order_has_no_insurance');
+    }
+    if (!order.selected_offer_id || !order.selected_offer_version || !order.pricing_snapshot) throw new BadRequestException('selected_offer_required');
+    if (order.insurance_decision?.idempotency_key === idempotencyKey) return { ok: true, idempotent: true, decision: order.insurance_decision };
+    if (order.insurance_decision) throw new BadRequestException('insurance_decision_already_recorded');
+
+    const offer: any = await this.offers.findOne({
+      id: order.selected_offer_id,
+      order_id: order.id,
+      status: 'selected',
+      version: order.selected_offer_version,
+    }).lean();
+    if (!offer) throw new BadRequestException('selected_offer_version_not_found');
+    const supplied = Array.isArray(body?.items) ? body.items : [];
+    const byOrderItem = new Map(supplied.map((item: any) => [String(item?.order_item_id || ''), item]));
+    if (byOrderItem.size !== offer.items.length || offer.items.some((item: any) => !byOrderItem.has(String(item.order_item_id)))) {
+      throw new BadRequestException('per_item_decision_required_for_selected_offer');
+    }
