+      { $setOnInsert: { aggregate_type: 'pharmacy_order', aggregate_id: order.id, event_type: 'pharmacy.insurance.decision_recorded', idempotency_key: idempotencyKey, payload: { order_id: order.id, patient_account_id: order.patient_account_id, decision }, state: 'pending', created_at: now } },
+      { upsert: true },
+    );
+    return { ok: true, decision, next_status: nextStatus };
+  }
+}
