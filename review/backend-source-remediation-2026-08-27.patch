[32m+[m[32m  async listReminders(user: any, active = true) {[m
[32m+[m[32m    const q: any = { patient_id: user.id };[m
[32m+[m[32m    if (active) q.active = true;[m
[32m+[m[32m    const rows = await this.reminders.find(q, { _id: 0, __v: 0 }).sort({ createdAt: -1 });[m
[32m+[m[32m    return rows.map((r: any) => {[m
[32m+[m[32m      const obj = r.toObject ? r.toObject() : r;[m
[32m+[m[32m      const time_zone = obj.time_zone || 'UTC';[m
[32m+[m[32m      const today = this.localDayKey(new Date(), time_zone);[m
[32m+[m[32m      const today_doses = (obj.times || []).map((time_key: string) => {[m
[32m+[m[32m        const entries = (obj.log || []).filter((entry: any) => entry?.time_key === time_key && entry?.at && this.localDayKey(entry.at, time_zone) === today);[m
[32m+[m[32m        const latest = entries.sort((a: any, b: any) => new Date(b.at).getTime() - new Date(a.at).getTime())[0];[m
[32m+[m[32m        return { time_key, status: latest?.status || 'pending', logged_at: latest?.at || null };[m
[32m+[m[32m      });[m
[32m+[m[32m      const taken = today_doses.length > 0 && today_doses.every((dose: any) => dose.status === 'taken');[m
[32m+[m[32m      return { ...obj, time_zone, today_doses, taken, adherence: { scheduled: today_doses.length, taken: today_doses.filter((dose: any) => dose.status === 'taken').length } };[m
[32m+[m[32m    });[m
[32m+[m[32m  }[m
