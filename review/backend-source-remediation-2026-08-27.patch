+        : 0;
+      if (itemOutcome === 'covered' && approvedQty <= 0) throw new BadRequestException('covered_item_requires_positive_approved_qty');
+      const coveredAmount = Math.round(Number(quoted.unit_price || 0) * approvedQty * 100) / 100;
+      insurerShare += coveredAmount;
+      return {
+        order_item_id: quoted.order_item_id,
+        quoted_qty: offeredQty,
+        approved_qty: approvedQty,
+        outcome: itemOutcome,
+        unit_price: Number(quoted.unit_price || 0),
+        insurer_share: coveredAmount,
+      };
+    });
+    const quotedTotal = Math.round(Number(order.pricing_snapshot.totals?.total || 0) * 100) / 100;
+    insurerShare = Math.round(insurerShare * 100) / 100;
+    const patientShare = Math.round(Math.max(0, quotedTotal - insurerShare) * 100) / 100;
+    if (outcome === 'full' && patientShare !== 0) throw new BadRequestException('full_decision_must_cover_selected_quote');
+    if (outcome === 'partial' && (patientShare <= 0 || insurerShare <= 0)) throw new BadRequestException('partial_decision_requires_split_shares');
+    if (outcome === 'rejected' && insurerShare !== 0) throw new BadRequestException('rejected_decision_must_not_cover_quote');
+
