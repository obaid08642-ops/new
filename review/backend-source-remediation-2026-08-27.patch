[32m+[m[32m    if (!current) throw new NotFoundException();[m
[32m+[m[32m    const currentData = typeof current.toObject === 'function' ? current.toObject() : current;[m
[32m+[m[32m    const normalized = this.normalizeVitalInput({ ...currentData, ...(data || {}) });[m
[32m+[m[32m    const r = await this.vitals.findOneAndUpdate({ id, patient_id: user.id, deleted_at: null }, { $set: normalized }, { new: true });[m
