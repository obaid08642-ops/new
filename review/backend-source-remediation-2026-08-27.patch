[32m+[m[32m  /**[m
[32m+[m[32m   * GET /health/score — REAL computed health score (0-100).[m
[32m+[m[32m   * Weighted average over the components that have actual data; a component[m
[32m+[m[32m   * with no data is EXCLUDED (never guessed). If fewer than 2 components have[m
[32m+[m[32m   * data the score is null with status insufficient_data — honest by design.[m
[32m+[m[32m   */[m
[32m+[m[32m  async healthScore(user: any) {[m
[32m+[m[32m    const [latest, profile, sleep, weekCount] = await Promise.all([[m
[32m+[m[32m      this.latestVitals(user),[m
[32m+[m[32m      this.conn.model('MedicalProfile').findOne({ patient_id: user.id }).select('height_cm weight_kg -_id').lean().catch(() => null),[m
[32m+[m[32m      this.sleepModel.findOne({ patient_id: user.id } as any, { _id: 0, __v: 0 } as any).sort({ measured_at: -1 }).catch(() => null),[m
[32m+[m[32m      this.vitals.countDocuments({ patient_id: user.id, measured_at: { $gte: new Date(Date.now() - 7 * 24 * 3600 * 1000) } } as any).catch(() => 0),[m
[32m+[m[32m    ]);[m
[32m+[m
[32m+[m[32m    const components: any[] = [];[m
[32m+[m[32m    const recommendations: string[] = [];[m
[32m+[m
[32m+[m[32m    // 1) BMI from profile measurements (weight 20)[m
[32m+[m[32m    const p: any = profile;[m
[32m+[m[32m    if (p?.height_cm > 0 && p?.weight_kg > 0) {[m
[32m+[m[32m      const bmi = p.weight_kg / Math.pow(p.height_cm / 100, 2);[m
[32m+[m[32m      const score = bmi < 18.5 ? 55 : bmi < 25 ? 100 : bmi < 30 ? 70 : bmi < 35 ? 40 : 20;[m
[32m+[m[32m      components.push({ key: 'bmi', label: 'مؤشر كتلة الجسم', weight: 20, score, detail: { bmi: +bmi.toFixed(1) } });[m
[32m+[m[32m      if (bmi >= 25) recommendations.push('مؤشر كتلة الجسم أعلى من الطبيعي — نشاط بدني منتظم وتغذية متوازنة يساعدان على خفضه');[m
[32m+[m[32m    } else {[m
[32m+[m[32m      recommendations.push('أكمل طولك ووزنك في الملف الصحي لتحسب درجتك بدقة أعلى');[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    // 2) Blood pressure (weight 20)[m
[32m+[m[32m    const bp = latest['bp'];[m
[32m+[m[32m    if (bp) {[m
[32m+[m[32m      const [sys, dia] = String(bp.value).split('/').map((x: string) => parseFloat(x));[m
[32m+[m[32m      const s = isNaN(sys) ? null : (sys <= 120 && (dia || 80) <= 80) ? 100 : (sys <= 130 && (dia || 85) <= 85) ? 80 : sys <= 140 ? 60 : 30;[m
[32m+[m[32m      if (s !== null) {[m
[32m+[m[32m        components.push({ key: 'bp', label: 'ضغط الدم', weight: 20, score: s, detail: { value: bp.value, measured_at: bp.measured_at } });[m
[32m+[m[32m        if (s < 80) recommendations.push('قراءة ضغط الدم الأخيرة مرتفعة — قلل الملح وراقب الضغط بانتظام واستشر طبيبك');[m
[32m+[m[32m      }[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    // 3) Glucose (weight 15)[m
[32m+[m[32m    const gl = latest['glucose'];[m
[32m+[m[32m    if (gl) {[m
[32m+[m[32m      const v = parseFloat(gl.value);[m
[32m+[m[32m      if (!isNaN(v)) {[m
[32m+[m[32m        const s = v >= 80 && v <= 140 ? 100 : v <= 180 ? 60 : 30;[m
[32m+[m[32m        components.push({ key: 'glucose', label: 'سكر الدم', weight: 15, score: s, detail: { value: gl.value, measured_at: gl.measured_at } });[m
[32m+[m[32m        if (s < 100) recommendations.push('قراءة السكر خارج النطاق الطبيعي — راجع خطة وجباتك وأدويتك مع طبيبك');[m
[32m+[m[32m      }[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    // 4) Heart rate (weight 10)[m
[32m+[m[32m    const hr = latest['heart_rate'];[m
[32m+[m[32m    if (hr) {[m
[32m+[m[32m      const v = parseFloat(hr.value);[m
[32m+[m[32m      if (!isNaN(v)) {[m
[32m+[m[32m        const s = v >= 60 && v <= 100 ? 100 : (v >= 50 && v <= 110) ? 60 : 30;[m
[32m+[m[32m        components.push({ key: 'heart_rate', label: 'نبض القلب', weight: 10, score: s, detail: { value: hr.value, measured_at: hr.measured_at } });[m
[32m+[m[32m      }[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    // 5) Sleep (weight 15) — latest device/manual sleep score[m
[32m+[m[32m    const sl: any = sleep;[m
[32m+[m[32m    if (sl?.sleep_score != null) {[m
[32m+[m[32m      components.push({ key: 'sleep', label: 'جودة النوم', weight: 15, score: Math.max(0, Math.min(100, sl.sleep_score)), detail: { duration_hours: sl.duration_hours, measured_at: sl.measured_at } });[m
[32m+[m[32m      if (sl.sleep_score < 60) recommendations.push('جودة نومك تحتاج تحسيناً — ثبّت موعد النوم وقلل الشاشات قبله');[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    // 6) Tracking consistency (weight 20) — readings logged in the last 7 days[m
[32m+[m[32m    if ((weekCount as number) > 0) {[m
[32m+[m[32m      const s = weekCount >= 5 ? 100 : weekCount >= 3 ? 70 : 40;[m
[32m+[m[32m      components.push({ key: 'tracking', label: 'انتظام التسجيل', weight: 20, score: s, detail: { readings_last_7d: weekCount } });[m
[32m+[m[32m      if (s < 100) recommendations.push('سجّل مؤشراتك الحيوية بانتظام (٥ قراءات أسبوعياً) لرفع دقة درجتك');[m
[32m+[m[32m    } else {[m
[32m+[m[32m      recommendations.push('ابدأ بتسجيل مؤشراتك الحيوية (ضغط، سكر، وزن) لتفعيل درجة الصحة');[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    if (components.length < 2) {[m
[32m+[m[32m      return {[m
[32m+[m[32m        score: null,[m
[32m+[m[32m        status: 'insufficient_data',[m
[32m+[m[32m        components,[m
[32m+[m[32m        recommendations,[m
[32m+[m[32m        message: 'لا توجد بيانات كافية لحساب درجة الصحة — أكمل ملفك وسجّل مؤشراتك',[m
[32m+[m[32m      };[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    const totalWeight = components.reduce((s, c) => s + c.weight, 0);[m
[32m+[m[32m    const weighted = components.reduce((s, c) => s + c.score * c.weight, 0);[m
[32m+[m[32m    const score = Math.round(weighted / totalWeight);[m
[32m+[m[32m    return {[m
[32m+[m[32m      score,[m
[32m+[m[32m      status: score >= 80 ? 'excellent' : score >= 60 ? 'good' : score >= 40 ? 'fair' : 'needs_attention',[m
[32m+[m[32m      components,[m
[32m+[m[32m      recommendations: recommendations.slice(0, 4),[m
[32m+[m[32m    };[m
[32m+[m[32m  }[m
