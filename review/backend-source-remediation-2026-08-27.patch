[32m+[m[32m  // REAL PDF GENERATION LOGIC[m
[32m+[m[32m  async generatePdf(orderId: string, user?: any): Promise<Buffer> {[m
[32m+[m[32m    const order = await this.orderModel.findOne({ id: orderId });[m
[32m+[m[32m    if (!order) throw new NotFoundException();[m
[32m+[m[32m    this.assertOrderAccess(order, user);[m
[32m+[m
[32m+[m[32m    return new Promise((resolve, reject) => {[m
[32m+[m[32m      try {[m
[32m+[m[32m        const doc = new PDFDocument({ margin: 50, size: 'A4' });[m
[32m+[m[32m      const buffers: any[] = [];[m
[32m+[m[32m      doc.on('data', buffers.push.bind(buffers));[m
[32m+[m[32m      doc.on('error', reject);[m
[32m+[m[32m      doc.on('end', () => {[m
[32m+[m[32m        resolve(Buffer.concat(buffers));[m
[32m+[m[32m      });[m
[32m+[m
[32m+[m[32m      // Header[m
[32m+[m[32m      doc.fontSize(24).fillColor('#004D40').text('Nabd Plus - Medical Report', { align: 'center' });[m
[32m+[m[32m      doc.moveDown();[m
[32m+[m[41m      [m
[32m+[m[32m      // Patient & Order Info[m
[32m+[m[32m      doc.fontSize(12).fillColor('#333333');[m
[32m+[m[32m      doc.text(`Order ID: ${order.id}`);[m
[32m+[m[32m      doc.text(`Date: ${new Date().toLocaleDateString()}`);[m
[32m+[m[32m      doc.moveDown(2);[m
[32m+[m
[32m+[m[32m      if (!order.results || order.results.length === 0) {[m
[32m+[m[32m        doc.fontSize(14).fillColor('#666666').text('No results available yet.', { align: 'center' });[m
[32m+[m[32m      } else {[m
[32m+[m[32m        // Table Header[m
[32m+[m[32m        const tableTop = doc.y;[m
[32m+[m[32m        doc.font('Helvetica-Bold');[m
[32m+[m[32m        doc.text('Test Name', 50, tableTop);[m
[32m+[m[32m        doc.text('Result', 250, tableTop);[m
[32m+[m[32m        doc.text('Reference', 350, tableTop);[m
[32m+[m[32m        doc.text('Status', 450, tableTop);[m
[32m+[m[32m        doc.moveTo(50, tableTop + 15).lineTo(500, tableTop + 15).stroke();[m
[32m+[m[41m        [m
[32m+[m[32m        let y = tableTop + 25;[m
[32m+[m[32m        doc.font('Helvetica');[m
[32m+[m
[32m+[m[32m        // Render each structured result[m
[32m+[m[32m        order.results.forEach((res: any) => {[m
[32m+[m[32m          const isAbnormal = res.isAbnormal === true;[m
[32m+[m[41m          [m
[32m+[m[32m          doc.fillColor('#333333').text(res.name || 'Unknown', 50, y);[m
[32m+[m[32m          doc.fillColor(isAbnormal ? '#D32F2F' : '#333333').text(String(res.result || '-'), 250, y);[m
[32m+[m[32m          doc.fillColor('#666666').text(res.reference || '-', 350, y);[m
[32m+[m[32m          doc.fillColor(isAbnormal ? '#D32F2F' : '#4CAF50').text(isAbnormal ? 'Abnormal' : 'Normal', 450, y);[m
[32m+[m[41m          [m
[32m+[m[32m          y += 20;[m
[32m+[m[32m          doc.moveTo(50, y - 5).lineTo(500, y - 5).strokeColor('#EEEEEE').stroke();[m
[32m+[m[32m        });[m
[32m+[m[32m      }[m
[32m+[m
[32m+[m[32m      // Footer[m
[32m+[m[32m      doc.fontSize(10).fillColor('#999999').text('Generated securely by Nabdah Systems.', 50, 750, { align: 'center' });[m
[32m+[m[32m        doc.end();[m
[32m+[m[32m      } catch (error) {[m
[32m+[m[32m        reject(error);[m
[32m+[m[32m      }[m
[32m+[m[32m    });[m
[32m+[m[32m  }[m
