[32m+[m
[32m+[m[32m  /**[m
[32m+[m[32m   * Complete refill flow: validate ownership → resolve default address → create[m
[32m+[m[32m   * a real pharmacy order. Creating an order is not proof of dispensing, so[m
[32m+[m[32m   * this path never invents a restocked pill count or next-refill date.[m
[32m+[m[32m   */[m
[32m+[m[32m  async refillNow(_user: any, _id: string): Promise<never> {[m
[32m+[m[32m    // Refill previously delegated to legacy OrdersService.create, which can[m
[32m+[m[32m    // auto-dispatch, persist PII, and create an orphan before canonical gates.[m
[32m+[m[32m    // No reservation or database mutation is allowed until a canonical refill[m
[32m+[m[32m    // PharmacyOrder command is implemented.[m
[32m+[m[32m    throw new ServiceUnavailableException('canonical_pharmacy_flow_required');[m
[32m+[m[32m    /*[m
[32m+[m[32m    const prep = await this.prepareRefill(user, id);[m
[32m+[m[32m    const reminder: any = prep.reminder;[m
[32m+[m[32m    if (!reminder.chronic) throw new BadRequestException('chronic reminder required for refill');[m
[32m+[m[32m    if (!reminder.medicine_id) throw new BadRequestException('eligible medicine identity required for refill');[m
[32m+[m[32m    if (reminder.refill_pending_order_id) {[m
[32m+[m[32m      return { ok: true, existing: true, order_id: reminder.refill_pending_order_id, state: 'REFILL_PENDING_FULFILLMENT' };[m
[32m+[m[32m    }[m
[32m+[m[32m    const reservation = uuid();[m
[32m+[m[32m    const reserved = await this.reminders.findOneAndUpdate([m
[32m+[m[32m      { id, patient_id: user.id, chronic: true, refill_pending_order_id: { $exists: false }, refill_creation_lock: { $exists: false } },[m
[32m+[m[32m      { $set: { refill_creation_lock: reservation } },[m
[32m+[m[32m      { new: true },[m
[32m+[m[32m    );[m
[32m+[m[32m    if (!reserved) {[m
[32m+[m[32m      const current: any = await this.reminders.findOne({ id, patient_id: user.id });[m
[32m+[m[32m      if (current?.refill_pending_order_id) {[m
[32m+[m[32m        return { ok: true, existing: true, order_id: current.refill_pending_order_id, state: 'REFILL_PENDING_FULFILLMENT' };[m
[32m+[m[32m      }[m
[32m+[m[32m      throw new ConflictException('refill creation already in progress');[m
[32m+[m[32m    }[m
[32m+[m[32m    // Resolve the patient's default delivery address from their profile[m
[32m+[m[32m    try {[m
[32m+[m[32m      const u: any = await (this.reminders as any).db.model('User').findOne({ id: user.id }).lean();[m
[32m+[m[32m      const addrs: any[] = u?.addresses || [];[m
[32m+[m[32m      const addr = addrs.find((a: any) => a.is_default) || addrs[0];[m
[32m+[m[32m      if (!addr?.lat || !addr?.lng) {[m
[32m+[m[32m        throw new BadRequestException('no_default_address: add a delivery address before reordering');[m
[32m+[m[32m      }[m
[32m+[m[32m      const order = await this.orders.create(user, {[m
[32m+[m[32m        items: prep.items,[m
[32m+[m[32m        delivery_address: { lat: addr.lat, lng: addr.lng, label: addr.label || addr.address || '', details: addr.details || '' },[m
[32m+[m[32m        notes: `refill:${id}`,[m
[32m+[m[32m      });[m
[32m+[m[32m      if (!order?.id) throw new BadRequestException('refill order could not be created');[m
[32m+[m[32m      // Tag the order as a refill so pharmacies see it in their refill inbox.[m
[32m+[m[32m      await (this.reminders as any).db.collection('orders').updateOne([m
[32m+[m[32m        { id: order.id },[m
[32m+[m[32m        { $set: { source: 'refill', refill_reminder_id: id } },[m
[32m+[m[32m      );[m
[32m+[m[32m      // Persist only the pending order identity. Dispensed quantity and follow-up[m
[32m+[m[32m      // dates need a verified fulfilment integration, never a fixed 30-day guess.[m
[32m+[m[32m      await this.reminders.findOneAndUpdate([m
[32m+[m[32m        { id, patient_id: user.id, refill_creation_lock: reservation },[m
[32m+[m[32m        { $set: { refill_pending_order_id: order.id }, $unset: { refill_creation_lock: 1 } },[m
[32m+[m[32m      );[m
[32m+[m[32m      return { ok: true, order_id: order.id, state: order.state, fulfillment_pending: true };[m
[32m+[m[32m    } catch (error) {[m
[32m+[m[32m      await this.reminders.findOneAndUpdate([m
[32m+[m[32m        { id, patient_id: user.id, refill_creation_lock: reservation },[m
[32m+[m[32m        { $unset: { refill_creation_lock: 1 } },[m
[32m+[m[32m      ).catch(() => undefined);[m
[32m+[m[32m      throw error;[m
[32m+[m[32m    }[m
[32m+[m[32m    */[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  /** Snooze refill date for a chronic reminder by N days (default 3) */[m
[32m+[m[32m  async snoozeRefill(user: any, id: string, days = 3) {[m
[32m+[m[32m    const r = await this.reminders.findOne({ id, patient_id: user.id });[m
