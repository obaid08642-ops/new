[32m+[m[32m  /** Chart series for one vital across fixed windows — real readings only, empty arrays when none. */[m
[32m+[m[32m  async vitalsChart(user: any, type: string) {[m
[32m+[m[32m    if (!type) throw new BadRequestException('vital query param required');[m
[32m+[m[32m    const now = Date.now();[m
[32m+[m[32m    const windows: Record<string, { spanMs: number; buckets: number }> = {[m
[32m+[m[32m      day: { spanMs: 24 * 3600e3, buckets: 8 },[m
[32m+[m[32m      week: { spanMs: 7 * 24 * 3600e3, buckets: 7 },[m
[32m+[m[32m      month: { spanMs: 30 * 24 * 3600e3, buckets: 10 },[m
[32m+[m[32m      year: { spanMs: 365 * 24 * 3600e3, buckets: 12 },[m
[32m+[m[32m    };[m
[32m+[m[32m    const readings = await this.vitals.find([m
[32m+[m[32m      { patient_id: user.id, type, deleted_at: null, measured_at: { $gte: new Date(now - windows.year.spanMs) } },[m
[32m+[m[32m      { _id: 0, value: 1, measured_at: 1 },[m
[32m+[m[32m    ).sort({ measured_at: 1 });[m
[32m+[m[32m    const result: Record<string, number[]> = { day: [], week: [], month: [], year: [] };[m
[32m+[m[32m    for (const [key, w] of Object.entries(windows)) {[m
[32m+[m[32m      const start = now - w.spanMs;[m
[32m+[m[32m      const inRange = readings.filter((r: any) => new Date(r.measured_at).getTime() >= start);[m
[32m+[m[32m      // average per bucket, omit empty buckets (honest series — no fabricated zeros)[m
[32m+[m[32m      const perBucket: number[] = [];[m
[32m+[m[32m      for (let b = 0; b < w.buckets; b++) {[m
[32m+[m[32m        const bStart = start + (b * w.spanMs) / w.buckets;[m
[32m+[m[32m        const bEnd = start + ((b + 1) * w.spanMs) / w.buckets;[m
[32m+[m[32m        const vals = inRange[m
[32m+[m[32m          .filter((r: any) => { const t = new Date(r.measured_at).getTime(); return t >= bStart && t < bEnd; })[m
[32m+[m[32m          .map((r: any) => parseFloat(r.value))[m
[32m+[m[32m          .filter((v: number) => isFinite(v));[m
[32m+[m[32m        if (vals.length) perBucket.push(Math.round((vals.reduce((a, c) => a + c, 0) / vals.length) * 10) / 10);[m
[32m+[m[32m      }[m
[32m+[m[32m      result[key] = perBucket;[m
[32m+[m[32m    }[m
[32m+[m[32m    return result;[m
[32m+[m[32m  }[m
