[32m+[m[32m    const [min, max] = ranges[type];[m
[32m+[m[32m    if (!Number.isFinite(value) || value < min || value > max) throw new BadRequestException('physiologically valid vital value required');[m
[32m+[m[32m    return { type, value: String(value), value_secondary: raw.value_secondary, unit: raw.unit || this.defaultUnit(type), measured_at: measured_at ? new Date(measured_at) : new Date(), context, notes: raw.notes, source: raw.source || 'manual' };[m
[32m+[m[32m  }[m
