[32m+[m[32m  /**[m
[32m+[m[32m   * Records the event time supplied by a local on-device reminder when it is safe to do so.[m
[32m+[m[32m   * This permits an offline action to be synchronised later without silently moving it to today.[m
[32m+[m[32m   */[m
[32m+[m[32m  async logReminder(user: any, id: string, status: 'taken' | 'skipped' | 'missed', time_key: string, occurred_at?: string) {[m
[32m+[m[32m    if (!['taken', 'skipped', 'missed'].includes(status)) throw new BadRequestException('invalid dose status');[m
[32m+[m[32m    const r = await this.reminders.findOne({ id, patient_id: user.id });[m
[32m+[m[32m    if (!r) throw new NotFoundException();[m
[32m+[m[32m    const timeKey = String(time_key || '').trim();[m
[32m+[m[32m    if (!/^([01]\d|2[0-3]):[0-5]\d$/.test(timeKey) || !(r.times || []).includes(timeKey)) {[m
[32m+[m[32m      throw new BadRequestException('time_key must match a configured reminder time');[m
[32m+[m[32m    }[m
[32m+[m[32m    const eventAt = occurred_at ? new Date(occurred_at) : new Date();[m
[32m+[m[32m    if (Number.isNaN(eventAt.getTime())) throw new BadRequestException('valid occurred_at required');[m
[32m+[m[32m    const now = Date.now();[m
[32m+[m[32m    if (eventAt.getTime() > now + 5 * 60 * 1000 || eventAt.getTime() < now - 7 * 24 * 60 * 60 * 1000) {[m
[32m+[m[32m      throw new BadRequestException('occurred_at must be within the last seven days');[m
[32m+[m[32m    }[m
[32m+[m[32m    const timezone = r.time_zone || 'UTC';[m
[32m+[m[32m    const eventDay = this.localDayKey(eventAt, timezone);[m
[32m+[m[32m    const startDay = this.localDayKey(r.start_date || new Date(), timezone);[m
[32m+[m[32m    if (eventDay < startDay) throw new BadRequestException('occurred_at must not precede the reminder start date');[m
[32m+[m[32m    if (r.end_date && eventDay > this.localDayKey(r.end_date, timezone)) throw new BadRequestException('occurred_at must not follow the reminder end date');[m
[32m+[m[32m    const duplicate = (r.log || []).some((entry: any) => entry?.time_key === timeKey && entry?.at && this.localDayKey(entry.at, timezone) === eventDay);[m
[32m+[m[32m    if (duplicate) throw new ConflictException('dose already logged for this reminder time on this local day');[m
[32m+[m[32m    r.log = [...(r.log || []), { at: eventAt, status, time_key: timeKey, source: occurred_at ? 'local_notification' : 'manual' }];[m
[32m+[m[32m    await r.save();[m
[32m+[m[32m    return r.toObject();[m
[32m+[m[32m  }[m
