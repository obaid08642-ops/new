[32m+[m[32m    await this.engine.announceCreated({ kind: 'pharmacy', entity_id: order.id, actor_account_id: patient.id, actor_role: 'patient', patient_account_id: patient.id, meta: { pharmacy_id: result.selected_pharmacy_id, items: items.length, total: order.total } });[m
