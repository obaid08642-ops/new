[32m+[m[32m  // MEDICATION REMINDERS[m
[32m+[m[32m  private validateReminderTimezone(value: any): string {[m
[32m+[m[32m    const timezone = String(value || '').trim();[m
[32m+[m[32m    if (!timezone || timezone.length > 64) throw new BadRequestException('valid time_zone required');[m
[32m+[m[32m    try { new Intl.DateTimeFormat('en-US', { timeZone: timezone }).format(new Date()); }[m
[32m+[m[32m    catch { throw new BadRequestException('valid IANA time_zone required'); }[m
[32m+[m[32m    return timezone;[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  private normalizeReminderTimes(value: any): string[] {[m
[32m+[m[32m    if (!Array.isArray(value) || value.length === 0 || value.length > 12) throw new BadRequestException('at least one time is required');[m
[32m+[m[32m    const times = value.map((time) => String(time || '').trim());[m
[32m+[m[32m    if (times.some((time) => !/^([01]\d|2[0-3]):[0-5]\d$/.test(time))) throw new BadRequestException('times must use HH:mm');[m
[32m+[m[32m    return [...new Set(times)].sort();[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  private localDayKey(value: Date | string, timezone: string): string {[m
[32m+[m[32m    const parts = new Intl.DateTimeFormat('en-US', { timeZone: timezone, year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date(value));[m
[32m+[m[32m    const part = (type: string) => parts.find((item) => item.type === type)?.value;[m
[32m+[m[32m    return `${part('year')}-${part('month')}-${part('day')}`;[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  private normalizeReminderInput(data: any, current?: any) {[m
[32m+[m[32m    const source = { ...(current || {}), ...(data || {}) };[m
[32m+[m[32m    const medicine_name_ar = String(source.medicine_name_ar || '').trim();[m
[32m+[m[32m    if (!medicine_name_ar || medicine_name_ar.length > 160) throw new BadRequestException('valid medicine_name_ar required');[m
[32m+[m[32m    const timezone = this.validateReminderTimezone(source.time_zone);[m
[32m+[m[32m    const times = this.normalizeReminderTimes(source.times);[m
[32m+[m[32m    const frequency = String(source.frequency || 'daily');[m
[32m+[m[32m    if (!['daily', 'weekly', 'as_needed'].includes(frequency)) throw new BadRequestException('invalid frequency');[m
[32m+[m[32m    const dosage_count = Number(source.dosage_count ?? 1);[m
[32m+[m[32m    if (!Number.isFinite(dosage_count) || dosage_count <= 0 || dosage_count > 10000) throw new BadRequestException('valid dosage_count required');[m
[32m+[m[32m    const duration_days = source.duration_days === undefined || source.duration_days === null || source.duration_days === '' ? 0 : Number(source.duration_days);[m
[32m+[m[32m    if (!Number.isInteger(duration_days) || duration_days < 0 || duration_days > 3650) throw new BadRequestException('valid duration_days required');[m
[32m+[m[32m    const start_date = source.start_date ? new Date(source.start_date) : (current?.start_date ? new Date(current.start_date) : new Date());[m
[32m+[m[32m    if (Number.isNaN(start_date.getTime())) throw new BadRequestException('valid start_date required');[m
[32m+[m[32m    const suppliedEnd = source.end_date ? new Date(source.end_date) : undefined;[m
[32m+[m[32m    if (suppliedEnd && Number.isNaN(suppliedEnd.getTime())) throw new BadRequestException('valid end_date required');[m
[32m+[m[32m    const end_date = duration_days > 0 ? new Date(start_date.getTime() + duration_days * 86400000) : suppliedEnd;[m
[32m+[m[32m    if (end_date && end_date.getTime() < start_date.getTime()) throw new BadRequestException('end_date must not precede start_date');[m
[32m+[m[32m    const pills_remaining = source.pills_remaining === undefined || source.pills_remaining === null || source.pills_remaining === '' ? 0 : Number(source.pills_remaining);[m
[32m+[m[32m    if (!Number.isInteger(pills_remaining) || pills_remaining < 0 || pills_remaining > 100000) throw new BadRequestException('valid pills_remaining required');[m
[32m+[m[32m    return { medicine_name_ar, time_zone: timezone, times, frequency, dosage_count, duration_days, start_date, end_date, pills_remaining };[m
[32m+[m[32m  }[m
