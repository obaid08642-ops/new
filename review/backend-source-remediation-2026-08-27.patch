[32m+[m[32m  // ============ STATE MACHINE TRANSITIONS ============[m
[32m+[m[32m  async transition(orderId: string, to: OrderState, by: any, reason?: string) {[m
[32m+[m[32m    const order = await this.orderModel.findOne({ id: orderId });[m
[32m+[m[32m    if (!order) throw new NotFoundException();[m
[32m+[m[32m    await this.assertNotCanonicalPharmacyOrder(order);[m
[32m+[m[32m    const allowed = ORDER_TRANSITIONS[order.state] || [];[m
[32m+[m[32m    if (by.role !== UserRole.ADMIN && by.role !== 'system' && !allowed.includes(to)) {[m
[32m+[m[32m      throw new BadRequestException(`Invalid transition ${order.state} → ${to}`);[m
[32m+[m[32m    }[m
[32m+[m[32m    const from = order.state;[m
[32m+[m[32m    return await this.engine.apply({[m
[32m+[m[32m      kind: 'pharmacy', entity_id: order.id, from_domain: from, to_domain: to,[m
[32m+[m[32m      actor_account_id: by.id, actor_role: by.role, patient_account_id: order.patient_id, reason,[m
[32m+[m[32m      mutate: async () => {[m
[32m+[m[32m        order.state = to;[m
[32m+[m[32m        order.state_history.push({ from, to, by_user_id: by.id, by_role: by.role, reason, at: new Date() } as any);[m
[32m+[m[32m        if (to === OrderState.REJECTED) {[m
[32m+[m[32m          order.rejection_reason = reason; order.rejected_by = by.id;[m
[32m+[m[32m          this.events.emit(EVENTS.ORDER_REJECTED, { order_id: order.id, patient_id: order.patient_id, pharmacy_id: order.pharmacy_id });[m
[32m+[m[32m          order.escalated = true;[m
[32m+[m[32m          order.state_history.push({ from: to, to: OrderState.ESCALATED_TO_ADMIN, by_user_id: 'system', by_role: 'system', reason: 'auto-escalate-on-reject', at: new Date() } as any);[m
[32m+[m[32m          order.state = OrderState.ESCALATED_TO_ADMIN;[m
[32m+[m[32m          this.events.emit(EVENTS.ORDER_ESCALATED, { order_id: order.id, patient_id: order.patient_id, pharmacy_id: order.pharmacy_id });[m
[32m+[m[32m        }[m
[32m+[m[32m        if (to === OrderState.READY_FOR_DISPATCH) {[m
[32m+[m[32m          const existingDel = await this.delModel.findOne({ order_id: order.id });[m
[32m+[m[32m          if (!existingDel) await this.delModel.create({ order_id: order.id, pharmacy_id: order.pharmacy_id, state: DeliveryState.UNASSIGNED });[m
[32m+[m[32m          this.events.emit(EVENTS.ORDER_READY, { order_id: order.id, patient_id: order.patient_id, pharmacy_id: order.pharmacy_id });[m
[32m+[m[32m        }[m
[32m+[m[32m        if (to === OrderState.ASSIGNED_TO_DELIVERY) this.events.emit(EVENTS.ORDER_ASSIGNED, { order_id: order.id, patient_id: order.patient_id, pharmacy_id: order.pharmacy_id });[m
[32m+[m[32m        if (to === OrderState.OUT_FOR_DELIVERY) this.events.emit(EVENTS.ORDER_OUT_FOR_DELIVERY, { order_id: order.id, patient_id: order.patient_id, pharmacy_id: order.pharmacy_id });[m
[32m+[m[32m        if (to === OrderState.DELIVERED) {[m
[32m+[m[32m          this.events.emit(EVENTS.ORDER_DELIVERED, { order_id: order.id, patient_id: order.patient_id, pharmacy_id: order.pharmacy_id });[m
[32m+[m[32m          // A chronic refill is fulfilled only after this verified delivery state.[m
[32m+[m[32m          // Do not infer a package quantity or a next-refill date without a[m
[32m+[m[32m          // dispensed-quantity contract from the pharmacy.[m
[32m+[m[32m          await this.conn.collection('medicationreminders').updateOne([m
[32m+[m[32m            { patient_id: order.patient_id, refill_pending_order_id: order.id },[m
[32m+[m[32m            { $set: { order_id: order.id, refill_fulfilled_at: new Date() }, $unset: { refill_pending_order_id: 1 } },[m
[32m+[m[32m          );[m
[32m+[m[32m        }[m
[32m+[m[32m        if (to === OrderState.CANCELLED) this.events.emit(EVENTS.ORDER_CANCELLED, { order_id: order.id, patient_id: order.patient_id, pharmacy_id: order.pharmacy_id });[m
[32m+[m[32m        if (to === OrderState.ACCEPTED) {[m
[32m+[m[32m          this.events.emit(EVENTS.ORDER_ACCEPTED, { order_id: order.id, patient_id: order.patient_id, pharmacy_id: order.pharmacy_id });[m
[32m+[m[32m          if (order.pharmacy_id) await this.dispatchSvc.deductStock(order.pharmacy_id, order.items.map((it: any) => ({ medicine_id: it.medicine_id, qty: it.qty })));[m
[32m+[m[32m        }[m
[32m+[m[32m        if (to === OrderState.PREPARING) this.events.emit(EVENTS.ORDER_PREPARING, { order_id: order.id, patient_id: order.patient_id, pharmacy_id: order.pharmacy_id });[m
[32m+[m[32m        if (to === OrderState.PARTIALLY_FULFILLED) this.events.emit(EVENTS.ORDER_PARTIAL, { order_id: order.id, patient_id: order.patient_id, pharmacy_id: order.pharmacy_id });[m
[32m+[m[32m        if (to === OrderState.PHARMACY_RECEIVED) this.events.emit(EVENTS.ORDER_RECEIVED_BY_PHARMACY, { order_id: order.id, patient_id: order.patient_id, pharmacy_id: order.pharmacy_id });[m
[32m+[m[32m        await order.save();[m
[32m+[m[32m        return order.toObject();[m
[32m+[m[32m      },[m
[32m+[m[32m    });[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  // ============ QUERIES ============[m
[32m+[m[32m  private assertOrderAccess(order: any, user?: any) {[m
[32m+[m[32m    if (!user) return;[m
[32m+[m[32m    const role = String(user.role || '').toLowerCase();[m
[32m+[m[32m    if (role === UserRole.ADMIN || role === 'admin' || role === 'super_admin') return;[m
[32m+[m[32m    if (role === UserRole.PATIENT && order.patient_id === user.id) return;[m
[32m+[m[32m    if (['pharmacy', 'provider'].includes(role) && order.pharmacy_id === user.id) return;[m
[32m+[m[32m    // Patient-owned order identifiers must not reveal existence to unrelated users.[m
[32m+[m[32m    throw new NotFoundException('order_not_found');[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  async getById(id: string, user?: any) {[m
[32m+[m[32m    const o = await this.orderModel.findOne({ id }, { _id: 0, __v: 0 });[m
[32m+[m[32m    if (!o) throw new NotFoundException();[m
[32m+[m[32m    this.assertOrderAccess(o, user);[m
[32m+[m[32m    // Hydrate sub-orders[m
[32m+[m[32m    if (o.is_split && o.sub_order_ids?.length) {[m
[32m+[m[32m      const subs = await this.orderModel.find({ id: { $in: o.sub_order_ids } }, { _id: 0, __v: 0 });[m
[32m+[m[32m      (o as any).sub_orders = subs;[m
[32m+[m[32m    }[m
[32m+[m[32m    return o;[m
[32m+[m[32m  }[m
[32m+[m[32m  async listMine(patient_id: string, type?: string) {[m
[32m+[m[32m    const q: any = { patient_id, parent_order_id: { $exists: false } };[m
[32m+[m[32m    if (type) {[m
[32m+[m[32m      q.type = type;[m
[32m+[m[32m    }[m
[32m+[m[32m    return this.orderModel.find(q, { _id: 0, __v: 0 }).sort({ createdAt: -1 }).limit(100);[m
[32m+[m[32m  }[m
[32m+[m[32m  async listForPharmacy(pharmacy_id: string, state?: OrderState) {[m
[32m+[m[32m    const q: any = { pharmacy_id };[m
[32m+[m[32m    if (state) q.state = state;[m
[32m+[m[32m    return this.orderModel.find(q, { _id: 0, __v: 0 }).sort({ createdAt: -1 }).limit(200);[m
[32m+[m[32m  }[m
[32m+[m[32m  async listAll(state?: OrderState, search?: string) {[m
[32m+[m[32m    const q: any = {};[m
[32m+[m[32m    if (state) q.state = state;[m
[32m+[m[32m    if (search) q.$or = [{ id: search }, { patient_phone: { $regex: search, $options: 'i' } }];[m
[32m+[m[32m    return this.orderModel.find(q, { _id: 0, __v: 0 }).sort({ createdAt: -1 }).limit(500);[m
[32m+[m[32m  }[m
[32m+[m[32m  async listEscalated() {[m
[32m+[m[32m    return this.orderModel.find({ escalated: true, state: { $ne: OrderState.DELIVERED } }, { _id: 0, __v: 0 });[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  // ============ PHARMACY ACTIONS ============[m
[32m+[m[32m  async accept(orderId: string, by: any) { return this.transition(orderId, OrderState.ACCEPTED, by); }[m
[32m+[m[32m  async reject(orderId: string, by: any, reason: string) {[m
[32m+[m[32m    // On rejection, attempt re-dispatch to next best pharmacy automatically[m
[32m+[m[32m    const order = await this.orderModel.findOne({ id: orderId });[m
[32m+[m[32m    if (!order) throw new NotFoundException();[m
[32m+[m[32m    const rejectedPharm = order.pharmacy_id;[m
[32m+[m[32m    await this.transition(orderId, OrderState.REJECTED, by, reason);[m
[32m+[m[32m    if (order.delivery_address?.lat && order.delivery_address?.lng) {[m
[32m+[m[32m      const result = await this.dispatchSvc.dispatchSplit([m
[32m+[m[32m        { lat: order.delivery_address.lat, lng: order.delivery_address.lng },[m
[32m+[m[32m        order.items.map((it: any) => ({ medicine_id: it.medicine_id, qty: it.qty })),[m
[32m+[m[32m        rejectedPharm ? [rejectedPharm] : [],[m
[32m+[m[32m      );[m
[32m+[m[32m      if (result.ok) {[m
[32m+[m[32m        order.pharmacy_id = result.selected_pharmacy_id!;[m
[32m+[m[32m        order.escalated = false;[m
[32m+[m[32m        order.state = OrderState.CREATED;[m
[32m+[m[32m        order.state_history.push({ from: OrderState.ESCALATED_TO_ADMIN, to: OrderState.CREATED, by_user_id: 'system', by_role: 'system', reason: 're-dispatch-after-rejection', at: new Date() } as any);[m
[32m+[m[32m        await order.save();[m
[32m+[m[32m        await this.transition(orderId, OrderState.PHARMACY_RECEIVED, { id: 'system', role: 'system' });[m
[32m+[m[32m      }[m
[32m+[m[32m    }[m
[32m+[m[32m    return this.getById(orderId);[m
[32m+[m[32m  }[m
[32m+[m[32m  async markPreparing(orderId: string, by: any) { return this.transition(orderId, OrderState.PREPARING, by); }[m
[32m+[m[32m  async markReady(orderId: string, by: any) { return this.transition(orderId, OrderState.READY_FOR_DISPATCH, by); }[m
[32m+[m[32m  async markPartial(orderId: string, by: any, unavailableMedicineIds: string[]) {[m
[32m+[m[32m    const o = await this.orderModel.findOne({ id: orderId });[m
[32m+[m[32m    if (!o) throw new NotFoundException();[m
[32m+[m[32m    const oldTotal = Number(o.total || 0);[m
[32m+[m[32m    o.items = o.items.map((it: any) => ({ ...it, unavailable: unavailableMedicineIds.includes(it.medicine_id) } as any));[m
[32m+[m[32m    o.subtotal = o.items.filter((it: any) => !it.unavailable).reduce((s: number, it: any) => s + it.price * it.qty, 0);[m
[32m+[m[32m    o.total = o.subtotal + (o.delivery_fee || 0);[m
[32m+[m[32m    await o.save();[m
[32m+[m[32m    const result = await this.transition(orderId, OrderState.PARTIALLY_FULFILLED, by);[m
[32m+[m
[32m+[m[32m    // E1 S18: paid order shrank → refund the difference (idempotent per total)[m
[32m+[m[32m    const diff = round2(oldTotal - Number(o.total || 0));[m
[32m+[m[32m    if (diff > 0 && o.payment_status === 'paid') {[m
[32m+[m[32m      try {[m
[32m+[m[32m        await this.refundExec.execute({[m
[32m+[m[32m          refund_id: `partial_${orderId}_${String(o.total).replace('.', '_')}`,[m
[32m+[m[32m          booking_kind: 'pharmacy', booking_id: orderId, patient_id: o.patient_id,[m
[32m+[m[32m          amount: diff, reason: 'partial fulfillment — unavailable items refunded', actor_id: by.id,[m
[32m+[m[32m        });[m
[32m+[m[32m      } catch (e: any) {[m
[32m+[m[32m        // Never block the operational transition; flag for admin follow-up[m
[32m+[m[32m        this.events.emit('refund.execution_failed', { order_id: orderId, amount: diff, error: e?.message });[m
[32m+[m[32m      }[m
[32m+[m[32m    }[m
[32m+[m[32m    return result;[m
[32m+[m[32m  }[m
[32m+[m[32m  /**[m
[32m+[m[32m   * E1 S3/S6 — cancellation with a real financial workflow:[m
[32m+[m[32m   *  1. Stage-based policy decides fees + stock restoration (who bears the cost).[m
[32m+[m[32m   *  2. Paid orders are REALLY refunded via the gateway (previously the check[m
[32m+[m[32m   *     `state === 'PAID'` could never be true — paid cancels NEVER refunded).[m
[32m+[m[32m   *  3. Wallet-paid portions go back to the wallet; loyalty points are[m
[32m+[m[32m   *     re-credited; coupon usage is released. All idempotent.[m
[32m+[m[32m   */[m
[32m+[m[32m  async cancel(orderId: string, by: any, reason: string) {[m
[32m+[m[32m    const order = await this.orderModel.findOne({ id: orderId });[m
[32m+[m[32m    if (!order) throw new NotFoundException();[m
[32m+[m[32m    await this.assertNotCanonicalPharmacyOrder(order);[m
[32m+[m[32m    this.assertOrderAccess(order, by);[m
[32m+[m
[32m+[m[32m    const policy = await this.cancelPolicy.forOrder(order.state as string, by.role, order.delivery_fee || 0);[m
[32m+[m[32m    if (!policy.allowed) {[m
[32m+[m[32m      throw new BadRequestException(`Cannot cancel order at this stage (${policy.block_reason || 'not_allowed'})`);[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    const wasPaid = order.payment_status === 'paid'[m
[32m+[m[32m      || !!(await this.conn.collection('moyasar_payments').findOne({ booking_id: orderId, status: 'paid' } as any));[m
[32m+[m
[32m+[m[32m    if (wasPaid) {[m
[32m+[m[32m      // Card portion (via gateway) — wallet portion is refunded separately below[m
[32m+[m[32m      const cardPaid: any = await this.conn.collection('moyasar_payments').findOne({ booking_id: orderId, status: 'paid' } as any);[m
[32m+[m[32m      const cardAmount = cardPaid ? Number(cardPaid.amount || 0) - Number(cardPaid.refunded_amount || 0) : 0;[m
[32m+[m[32m      const refundViaGateway = round2(Math.max(0, cardAmount - policy.fee_sar));[m
[32m+[m[32m      if (refundViaGateway > 0) {[m
[32m+[m[32m        await this.refundExec.execute({[m
[32m+[m[32m          refund_id: `cancel_${orderId}`,[m
[32m+[m[32m          booking_kind: 'pharmacy',[m
[32m+[m[32m          booking_id: orderId,[m
[32m+[m[32m          patient_id: order.patient_id,[m
[32m+[m[32m          amount: refundViaGateway,[m
[32m+[m[32m          reason: reason || `cancellation by ${by.role}`,[m
[32m+[m[32m          actor_id: by.id,[m
[32m+[m[32m        });[m
[32m+[m[32m      }[m
[32m+[m[32m      // Wallet portion → back to the wallet (idempotent via referenceId)[m
[32m+[m[32m      let walletApplied = Number((order as any).wallet_applied || 0);[m
[32m+[m[32m      if (walletApplied <= 0) {[m
[32m+[m[32m        // Legacy fallback: orders created before wallet_applied was persisted (strict schema[m
[32m+[m[32m        // dropped it) — recover the debited amount from the wallet ledger itself.[m
[32m+[m[32m        const debits = await this.conn.collection('wallet_transactions')[m
[32m+[m[32m          .find({ referenceType: 'booking', referenceId: orderId, type: 'debit' } as any).toArray();[m
[32m+[m[32m        walletApplied = round2(debits.reduce((s: number, t: any) => s + Number(t.amount || 0), 0));[m
[32m+[m[32m      }[m
[32m+[m[32m      if (walletApplied > 0) {[m
[32m+[m[32m        const already: any = await this.conn.collection('wallet_transactions').findOne({ referenceId: `cancel_${orderId}` } as any);[m
[32m+[m[32m        if (!already) {[m
[32m+[m[32m          const wallet: any = await this.conn.collection('wallets').findOne({ ownerId: order.patient_id, ownerType: 'patient' } as any);[m
[32m+[m[32m          if (wallet) {[m
[32m+[m[32m            await this.conn.collection('wallets').updateOne({ _id: wallet._id } as any, { $inc: { balance: walletApplied }, $set: { updatedAt: new Date() } });[m
[32m+[m[32m            await this.conn.collection('wallet_transactions').insertOne({[m
[32m+[m[32m              id: require('uuid').v4(), walletId: wallet.id, amount: walletApplied, type: 'credit',[m
[32m+[m[32m              referenceType: 'refund', referenceId: `cancel_${orderId}`,[m
[32m+[m[32m              description: `استرداد محفظة لإلغاء الطلب #${orderId.slice(0, 8)}`,[m
[32m+[m[32m              createdAt: new Date(), updatedAt: new Date(),[m
[32m+[m[32m            } as any);[m
[32m+[m[32m          }[m
[32m+[m[32m        }[m
[32m+[m[32m      }[m
[32m+[m[32m      const upd: any = { refund_status: 'REFUNDED', payment_status: 'refunded', refunded_at: new Date() };[m
[32m+[m[32m      if (policy.fee_sar > 0) {[m
[32m+[m[32m        upd.cancellation_fee = policy.fee_sar;[m
[32m+[m[32m        upd.cancellation_fee_reason = policy.fee_reason;[m
[32m+[m[32m      }[m
[32m+[m[32m      await this.orderModel.updateOne({ id: orderId }, { $set: upd } as any);[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    // Loyalty points re-credit + coupon release (idempotent)[m
[32m+[m[32m    try { await this.loyaltyRedeem.refundRedemption(order.patient_id, orderId); } catch { /* never block cancel */ }[m
[32m+[m[32m    try { await this.coupons.release(orderId); } catch { /* never block cancel */ }[m
[32m+[m
[32m+[m[32m    // Stock restoration when the pharmacy had already accepted (deducted stock)[m
[32m+[m[32m    if (policy.restore_stock && order.pharmacy_id) {[m
[32m+[m[32m      try {[m
[32m+[m[32m        await this.dispatchSvc.restoreStock(order.pharmacy_id, order.items.map((it: any) => ({ medicine_id: it.medicine_id, qty: it.qty })));[m
[32m+[m[32m      } catch { /* stock restore must never block the cancellation itself */ }[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    return this.transition(orderId, OrderState.CANCELLED, by, reason);[m
[32m+[m[32m  }[m
