+import { BadRequestException } from '@nestjs/common';
+import { PharmacyInsuranceDecisionService } from '../services/pharmacy-insurance-decision.service';
+
+describe('PharmacyInsuranceDecisionService', () => {
+  const order = () => ({
+    id: 'order-1', patient_account_id: 'patient-1', payment_method: 'insurance',
+    selected_offer_id: 'offer-1', selected_offer_version: 2,
+    pricing_snapshot: { totals: { total: 120, currency: 'SAR' } },
+  });
+  const offer = () => ({
+    id: 'offer-1', order_id: 'order-1', version: 2, status: 'selected', totals: { total: 120, currency: 'SAR' },
+    items: [
+      { order_item_id: 'item-1', qty_offered: 2, unit_price: 20 },
+      { order_item_id: 'item-2', qty_offered: 1, unit_price: 80 },
+    ],
+  });
+
+  function setup() {
+    const outbox = { updateOne: jest.fn().mockResolvedValue({ upsertedCount: 1 }) };
+    const orders: any = { findOne: jest.fn().mockResolvedValue(order()), updateOne: jest.fn().mockResolvedValue({ modifiedCount: 1 }), db: { collection: jest.fn(() => outbox) } };
+    const offers: any = { findOne: jest.fn().mockReturnValue({ lean: jest.fn().mockResolvedValue(offer()) }) };
+    return { service: new PharmacyInsuranceDecisionService(orders, offers), orders, outbox };
+  }
+
+  it('calculates partial shares from the selected quote and never accepts client money amounts', async () => {
+    const { service, orders, outbox } = setup();
+    const result = await service.decide({ id: 'admin-1', role: 'admin' }, 'order-1', {
+      outcome: 'partial', approval_reference: 'MANUAL-REF-100', reason: 'limit', idempotency_key: 'insurance_key_000001',
+      // These malicious monetary fields must be ignored; only offer quantities may be decided.
+      copay: 1, coveredAmount: 99999,
+      items: [{ order_item_id: 'item-1', outcome: 'covered', approved_qty: 2 }, { order_item_id: 'item-2', outcome: 'rejected' }],
+    });
+    expect(result.decision.insurer_share).toBe(40);
+    expect(result.decision.patient_share).toBe(80);
+    expect(orders.updateOne).toHaveBeenCalledWith(expect.anything(), expect.objectContaining({ $set: expect.objectContaining({ status: 'waiting_copay' }) }));
+    expect(outbox.updateOne).toHaveBeenCalledWith(expect.anything(), expect.anything(), expect.objectContaining({ upsert: true }));
+  });
+
+  it('rejects a full decision that does not cover the entire selected quote', async () => {
+    const { service } = setup();
+    await expect(service.decide({ id: 'admin-1', role: 'admin' }, 'order-1', {
+      outcome: 'full', approval_reference: 'MANUAL-REF-101', idempotency_key: 'insurance_key_000002',
+      items: [{ order_item_id: 'item-1', outcome: 'covered', approved_qty: 2 }, { order_item_id: 'item-2', outcome: 'rejected' }],
+    })).rejects.toBeInstanceOf(BadRequestException);
+  });
+
+  it('rejects a decision for an unselected or incomplete quote', async () => {
+    const { service } = setup();
+    await expect(service.decide({ id: 'admin-1', role: 'admin' }, 'order-1', {
+      outcome: 'partial', approval_reference: 'MANUAL-REF-102', reason: 'limit', idempotency_key: 'insurance_key_000003',
+      items: [{ order_item_id: 'item-1', outcome: 'covered', approved_qty: 1 }],
+    })).rejects.toBeInstanceOf(BadRequestException);
+  });
+});
