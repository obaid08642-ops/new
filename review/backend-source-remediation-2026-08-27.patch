[32m+[m[32m    // Engagement loop: loyalty listens for this to award vitals_logged points (capped 5/day)[m
[32m+[m[32m    try { this.events?.emit('health.vitals_logged', { user_id: user.id }); } catch {}[m
[32m+[m[32m    return reading.toObject();[m
