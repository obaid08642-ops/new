+    const decision = {
+      outcome,
+      approval_reference: approvalReference,
+      reason: reason || null,
+      offer_id: offer.id,
+      offer_version: offer.version,
+      quote_total: quotedTotal,
+      insurer_share: insurerShare,
+      patient_share: patientShare,
+      currency: offer.totals?.currency || 'SAR',
+      items: itemDecisions,
+      idempotency_key: idempotencyKey,
+      decided_by: admin.id,
+      decided_at: now,
+    };
+    const nextStatus = outcome === 'full'
+      ? PharmacyOrderState.CONFIRMED
+      : outcome === 'partial'
+        ? PharmacyOrderState.WAITING_COPAY
+        : PharmacyOrderState.MANUAL_REVIEW;
+    const result = await this.orders.updateOne(
+      { id: order.id, selected_offer_id: offer.id, selected_offer_version: offer.version, insurance_decision: { $exists: false } },
+      { $set: { insurance_decision: decision, status: nextStatus }, $push: { timeline: { ts: now, event: 'insurance_decision_recorded', by: admin.id, meta: { outcome, approval_reference: approvalReference, offer_id: offer.id, offer_version: offer.version } } } },
+    );
