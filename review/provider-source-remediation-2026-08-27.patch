[32m+[m[32m    const fetchBroadcasts = async () => {[m
[32m+[m[32m      try {[m
[32m+[m[32m        const response = await client.get('/provider/pharmacy/broadcasts');[m
[32m+[m[32m        if (disposed) return;[m
[32m+[m[32m        const rows = normalizeBroadcasts(response.data);[m
[32m+[m[32m        const incoming = rows.some((row: any) => !knownBroadcastIds.current.has(row.id));[m
[32m+[m[32m        knownBroadcastIds.current = new Set(rows.map((row: any) => row.id));[m
[32m+[m[32m        setBroadcasts(rows);[m
[32m+[m[32m        if (incoming) await playAlarm();[m
[32m+[m[32m      } catch {[m
[32m+[m[32m        // Keep the last server-confirmed rows; never fabricate a broadcast locally.[m
[32m+[m[32m      }[m
