[32m+[m[32m    }[m
[32m+[m
[32m+[m[32m    let disposed = false;[m
[32m+[m[32m    let socket: Socket | undefined;[m
[32m+[m[32m    const normalizeBroadcasts = (data: any) => {[m
[32m+[m[32m      const raw = Array.isArray(data) ? data : (data?.items || []);[m
[32m+[m[32m      return raw.map((broadcast: any) => ({[m
[32m+[m[32m        id: broadcast.id,[m
[32m+[m[32m        order_id: broadcast.order_id,[m
