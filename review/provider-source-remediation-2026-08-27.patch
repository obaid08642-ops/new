[32m+[m[32m        require('../../../assets/audio/rad_dispatch_alert.mp3')[m
[32m+[m[32m      );[m
[32m+[m[32m      setSound(sound);[m
[32m+[m[32m      await sound.playAsync();[m
[32m+[m[32m    } catch (e) {[m
[32m+[m[32m      console.warn("Could not play alarm sound", e);[m
[32m+[m[32m    }[m
[32m+[m[32m  }[m
[32m+[m
[32m+[m[32m  useEffect(() => {[m
[32m+[m[32m    return sound ? () => { sound.unloadAsync(); } : undefined;[m
[32m+[m[32m  }, [sound]);[m
[32m+[m
[32m+[m[32m    useEffect(() => {[m
[32m+[m[32m    if (!isOnline) {[m
